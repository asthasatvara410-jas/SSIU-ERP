// SSIU ERP — Prisma Database Schema
// Backends 1–8: Core Masters, Auth, RBAC, Workflow, Academic, Exam, Fees, Store, Purchase, Asset

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// 1. GOVERNANCE & ACADEMIC STRUCTURE MASTERS
// ──────────────────────────────────────────────────────────────────────────────

model University {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  tagline   String?
  address   String?
  website   String?
  email     String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutes Institute[]
}

model Institute {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  shortName    String?
  universityId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id])
  departments Department[]
  students    Student[]
  faculty     Faculty[]
  employees   Employee[]
  researchProjects ResearchProject[]
  libraries        Library[]
  feeStructures    FeeStructure[]

  @@index([universityId])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  instituteId String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id])
  programs  Program[]
  students  Student[]
  faculty   Faculty[]
  employees Employee[]
  researchProjects ResearchProject[]
  inwardRegisters  InwardRegister[]
  outwardRegisters OutwardRegister[]
  serviceRequests  StudentServiceRequest[]
  edpDuties        EdpDuty[]
  feeStructures    FeeStructure[]
  accreditationValues AccreditationAggregatedValue[]

  @@index([instituteId])
}

model Program {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  shortName    String?
  departmentId String
  durationYears Int     @default(4)
  degreeType   String   @default("UG") // UG | PG | DIPLOMA | PHD
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department    @relation(fields: [departmentId], references: [id])
  batches      Batch[]
  subjects     Subject[]
  feeStructures FeeStructure[]
  exams        Exam[]
  digitalResources DigitalResource[]
  accreditationValues AccreditationAggregatedValue[]

  @@index([departmentId])
}

model AcademicYear {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. 2024-25
  startYear Int
  endYear   Int
  isCurrent Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches              Batch[]
  studentMentorMappings StudentMentorMapping[]
  academicRisks        AcademicRisk[]
  feeStructures        FeeStructure[]
}

model Batch {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. CSE-2024
  programId    String
  academicYearId String
  startYear    Int
  endYear      Int
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program      Program      @relation(fields: [programId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  semesters    Semester[]
  students     Student[]

  @@index([programId])
  @@index([academicYearId])
}

model Semester {
  id           String   @id @default(uuid())
  batchId      String
  semesterNumber Int
  name         String   // e.g. Semester 1
  startDate    DateTime?
  endDate      DateTime?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batch         Batch        @relation(fields: [batchId], references: [id])
  divisions     Division[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  examForms     ExamForm[]
  examSchedules ExamSchedule[]

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]
  academicRisks          AcademicRisk[]

  @@unique([batchId, semesterNumber])
  @@index([batchId])
}

model Division {
  id         String   @id @default(uuid())
  semesterId String
  name       String   // A, B, C
  capacity   Int      @default(60)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semester Semester @relation(fields: [semesterId], references: [id])
  students Student[]

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

model Subject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  programId   String
  semesterId  String?
  credits     Int      @default(3)
  subjectType String   @default("THEORY") // THEORY | PRACTICAL | LAB | ELECTIVE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program  Program  @relation(fields: [programId], references: [id])
  semester Semester? @relation(fields: [semesterId], references: [id])

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]
  examSchedules          ExamSchedule[]
  examResults            ExamResult[]
  examSubjects           ExamSubject[]
  examFormSubjects       ExamFormSubject[]
  books                  Book[]
  digitalResources       DigitalResource[]

  @@index([programId])
  @@index([semesterId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 2. PEOPLE MASTERS — STUDENT & FACULTY
// ──────────────────────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(uuid())
  erpId        String   @unique // STU000001
  enrollmentNo String   @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String?
  dateOfBirth  DateTime?
  gender       String?
  instituteId  String
  departmentId String
  batchId      String
  currentDivisionId String?
  
  // Academic Bank of Credits (ABC) ID
  abcId                 String?
  abcIdStatus           String    @default("NOT_SUBMITTED") // NOT_SUBMITTED | PENDING_VERIFICATION | VERIFIED | REJECTED
  abcIdVerifiedByUserId String?
  abcIdVerifiedByName   String?
  abcIdVerifiedAt       DateTime?
  abcIdRejectionReason  String?
  abcIdAcademicYear     String?
  abcIdRemarks          String?
  
  // Temporary & Final Enrollment Lifecycle
  temporaryEnrollmentNumber String?   @unique // e.g. TEMP-2026-00001
  finalEnrollmentNumber     String?   @unique // e.g. 2026CE000123
  enrollmentStatus          String    @default("TEMPORARY") // TEMPORARY | FINAL
  studentAccessCode         String?   // 5-digit secure access code e.g. "48271"
  onboardingCompletedAt     DateTime?
  finalEnrollmentAssignedAt DateTime?
  finalEnrollmentAssignedBy String?
  firstLoginAt              DateTime?
  
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | GRADUATED | DROPPED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  batch      Batch      @relation(fields: [batchId], references: [id])
  division   Division?  @relation(fields: [currentDivisionId], references: [id])
  user       User?

  studentFacultyMappings StudentFacultyMapping[]
  studentMentorMappings  StudentMentorMapping[]
  mentorAssignments      MentorAssignment[]
  examForms              ExamForm[]
  examResults            ExamResult[]
  feeAccounts            StudentFeeAccount[]
  transportApplications  TransportApplication[]
  transportAllotments    TransportAllotment[]
  transportPasses        TransportPass[]
  transportAttendances   TransportAttendance[]
  transportComplaints    TransportComplaint[]
  startupMemberships     StartupMember[]
  placementApplications  PlacementApplication[]
  trainingEnrollments    TrainingEnrollment[]
  alumniProfile          AlumniProfile?
  serviceRequests        StudentServiceRequest[]
  certificates           Certificate[]
  hallTickets            HallTicket[]
  resultSummaries        ResultSummary[]
  revaluations           RevaluationRequest[]
  hostelApplications     HostelApplication[]
  hostelAllotments       HostelAllotment[]
  hostelAttendances      HostelAttendance[]
  outpassRequests        OutpassRequest[]
  hostelComplaints       HostelComplaint[]
  hostelMaintenanceRequests HostelMaintenanceRequest[]
  messEnrollments        MessEnrollment[]
  academicRisks          AcademicRisk[]
  roomAllocations        ExamRoomAllocation[]
  hostelVisitors         HostelVisitor[]
  feeInvoices            FeeInvoice[]
  paymentOrders          PaymentOrder[]
  paymentTransactions    PaymentTransaction[]
  paymentReceipts        PaymentReceipt[]
  seatAllocations        ExamSeatAllocation[]
  dataChangeRequests     StudentDataChangeRequest[]
  dataChangeAudits       StudentDataChangeRequestAuditLog[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([batchId])
}

model Faculty {
  id           String   @id @default(uuid())
  erpId        String   @unique // FAC000001
  employeeCode String   @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String?
  designation  String?
  instituteId  String
  departmentId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?

  studentFacultyMappings StudentFacultyMapping[]
  studentMentorMappings  StudentMentorMapping[]  @relation("MentorFaculty")
  mentorAssignments      MentorAssignment[]
  facultySubjectMappings FacultySubjectMapping[]
  researchMemberships    ResearchMember[]
  startupMentorships     StartupMentor[]
  edpDutiesObserved      EdpDuty[]             @relation("EdpDutyTeachingFaculty")

  @@index([instituteId])
  @@index([departmentId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 3. AUTH & USER ACCOUNT SYSTEM
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  erpId                String    @unique
  username             String    @unique
  passwordHash         String
  accountStatus        String    @default("ACTIVE") // ACTIVE | INACTIVE | LOCKED | SUSPENDED
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  temporaryEnrollmentNumber String?   @unique
  finalEnrollmentNumber     String?   @unique
  enrollmentStatus          String    @default("TEMPORARY") // TEMPORARY | FINAL
  studentAccessCode         String?
  isFirstLogin              Boolean   @default(true)
  studentId            String?   @unique
  facultyId            String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student Student? @relation(fields: [studentId], references: [id])
  faculty Faculty? @relation(fields: [facultyId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginAudits        LoginAudit[]
  userRoles          UserRole[]

  workflowInstancesRequested WorkflowInstance[] @relation("RequestedByRelation")
  workflowHistories          WorkflowHistory[]  @relation("HistoryPerformedBy")
  delegationsGiven           WorkflowDelegation[] @relation("DelegatorRelation")
  delegationsReceived        WorkflowDelegation[] @relation("DelegateeRelation")

  // Store & Purchase
  stockIssuesTo      StockIssue[]    @relation("IssuedToUser")
  stockIssuesBy      StockIssue[]    @relation("IssuedByUser")
  purchaseRequestsBy PurchaseRequest[] @relation("RequestedByUser")
  assetAssignments   AssetAssignment[] @relation("AssignedToUser")
  employee           Employee?         @relation("UserEmployee")
  itTickets          ITTicket[]
  campusRequests     CampusServiceRequest[]
  researchProjectsCreated ResearchProject[] @relation("ResearchCreatedBy")
  innovations             InnovationIdea[]  @relation("InnovationCreator")
  placementApplications   PlacementApplication[]
  userOrgReporting        UserOrgReporting?
  userRoleHistories       UserRoleHistory[]
  workDiaries             WorkDiary[]
  workTasks               WorkTask[]
  personalAppointments    PersonalAppointment[]
  workFollowUps           WorkFollowUp[]
  personalNotes           PersonalNote[]
  communicationsCreated   Communication[]       @relation("CommCreator")
  libraryMemberships      LibraryMembership[]
  inwardRegistersReceived InwardRegister[]      @relation("InwardReceiver")
  inwardRegistersAssigned InwardRegister[]      @relation("InwardAssignee")
  inwardForwardingsCreated InwardForwarding[]   @relation("InwardForwarder")
  outwardRegistersSent    OutwardRegister[]     @relation("OutwardSender")
  registerAuditLogs       InwardOutwardAuditLog[] @relation("RegisterAuditActor")
  edpDutiesAssigned       EdpDuty[]             @relation("EdpDutyOfficer")
  noteSheetsCreated       NoteSheet[]           @relation("NoteSheetCreator")
  examEdpDuties           ExamEdpDuty[]         @relation("ExamEdpStaff")
  bulkImports             BulkImport[]          @relation("BulkImportUploader")

  @@index([username])
  @@index([erpId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// 4. RBAC — ROLE, PERMISSION & AUTHORITY ENGINE
// ──────────────────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  authorityLevel Int      @default(10)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([authorityLevel])
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?
  scopeType   String   @default("UNIVERSITY") // UNIVERSITY | INSTITUTE | DEPARTMENT | PROGRAM
  scopeId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String   // VIEW | CREATE | EDIT | DELETE | APPROVE | REJECT | PUBLISH | EXPORT | IMPORT | CONFIGURE | ASSIGN
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RbacAudit {
  id                String   @id @default(uuid())
  performedByUserId String?
  targetUserId      String?
  targetRoleId      String?
  action            String   // ROLE_ASSIGNED | ROLE_REMOVED | ROLE_CREATED | ROLE_UPDATED | PERMISSIONS_UPDATED
  details           String?
  createdAt         DateTime @default(now())

  @@index([targetUserId])
  @@index([performedByUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 5. WORKFLOW & APPROVAL ENGINE
// ──────────────────────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  requestType String
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@index([code])
  @@index([module])
}

model WorkflowStep {
  id                   String   @id @default(uuid())
  workflowDefinitionId String
  stepNumber           Int
  stepName             String
  requiredRoleCode     String
  minAuthorityLevel    Int      @default(10)
  dataScope            String   @default("OWN")
  actionsAllowed       String
  slaHours             Int?     @default(24)
  isRequired           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([workflowDefinitionId, stepNumber])
  @@index([workflowDefinitionId])
}

model WorkflowInstance {
  id                    String    @id @default(uuid())
  workflowDefinitionId  String
  entityId              String
  module                String
  currentStatus         String    @default("DRAFT")
  currentStepNumber     Int       @default(1)
  currentAssigneeRoleId String?
  requestedByUserId     String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  dueDate               DateTime?
  priority              String    @default("NORMAL")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  requestedByUser    User               @relation("RequestedByRelation", fields: [requestedByUserId], references: [id])
  histories          WorkflowHistory[]

  @@index([workflowDefinitionId])
  @@index([entityId])
  @@index([currentStatus])
  @@index([requestedByUserId])
}

model WorkflowHistory {
  id                        String   @id @default(uuid())
  instanceId                String
  action                    String
  fromStatus                String
  toStatus                  String
  performedByUserId         String
  performedByRoleId         String?
  performedByAuthorityLevel Int?
  stepNumber                Int
  comments                  String?
  attachmentUrl             String?
  createdAt                 DateTime @default(now())

  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  performedByUser User             @relation("HistoryPerformedBy", fields: [performedByUserId], references: [id])

  @@index([instanceId])
  @@index([performedByUserId])
}

model WorkflowDelegation {
  id                String    @id @default(uuid())
  delegatorUserId   String
  delegateeUserId   String
  minAuthorityLevel Int       @default(10)
  startDate         DateTime
  endDate           DateTime
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  delegatorUser User @relation("DelegatorRelation", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegateeUser User @relation("DelegateeRelation", fields: [delegateeUserId], references: [id], onDelete: Cascade)

  @@index([delegatorUserId])
  @@index([delegateeUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 6. ACADEMIC MAPPING & COURSE RELATION MASTERS
// ──────────────────────────────────────────────────────────────────────────────

model StudentFacultyMapping {
  id               String   @id @default(uuid())
  studentId        String
  facultyId        String
  subjectId        String
  semesterId       String
  divisionId       String
  mappingType      String   @default("COURSE_TEACHER")
  status           String   @default("ACTIVE")
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, mappingType])
  @@index([studentId])
  @@index([facultyId])
  @@index([subjectId])
}

model StudentMentorMapping {
  id               String   @id @default(uuid())
  studentId        String
  mentorFacultyId  String
  academicYearId   String
  status           String   @default("ACTIVE")
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty      Faculty      @relation("MentorFaculty", fields: [mentorFacultyId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([mentorFacultyId])
}

model MentorAssignment {
  id               String   @id @default(uuid())
  studentId        String
  mentorFacultyId  String
  assignedByUserId String
  assignedByRole   String   // HOD, PRINCIPAL, SUPER_ADMIN
  assignedByName   String?
  instituteId      String
  departmentId     String
  programId        String
  academicYearId   String
  semesterId       String?
  section          String?  // e.g. "Div A"
  assignedDate     DateTime @default(now())
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  changeReason     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty          Faculty  @relation(fields: [mentorFacultyId], references: [id], onDelete: Cascade)
  history          MentorAssignmentHistory[]

  @@index([studentId])
  @@index([mentorFacultyId])
  @@index([departmentId])
  @@index([instituteId])
  @@index([status])
}

model MentorAssignmentHistory {
  id                 String   @id @default(uuid())
  assignmentId       String
  studentId          String
  previousMentorId   String?
  previousMentorName String?
  newMentorId        String
  newMentorName      String
  changedByUserId    String
  changedByName      String
  changedByRole      String
  changeReason       String
  effectiveFrom      DateTime
  effectiveTo        DateTime @default(now())
  createdAt          DateTime @default(now())

  assignment         MentorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
}

model FacultySubjectMapping {
  id         String   @id @default(uuid())
  facultyId  String
  subjectId  String
  divisionId String
  semesterId String
  status     String   @default("ACTIVE")
  assignedAt DateTime @default(now())

  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([facultyId, subjectId, divisionId])
  @@index([facultyId])
  @@index([subjectId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 7. EXAMINATION & FEES MANAGEMENT
// ──────────────────────────────────────────────────────────────────────────────

// --- EXAM SECTION ---

model ExamType {
  id          String   @id @default(uuid())
  code        String   @unique  // INTERNAL | EXTERNAL | PRACTICAL | VIVA | MIDTERM | ENDTERM
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams Exam[]
}

model Exam {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  examTypeId       String?
  type             String?   // Regular, Backlog, Supplementary, Remedial, Re-Examination, Improvement, Special Examination, Other
  programId        String
  academicYearId   String?
  academicYearCode String?   // e.g. 2026-27
  semesterId       String?
  semesterNumber   Int?
  instituteId      String?
  departmentId     String?
  session          String?   // e.g. Summer 2026, Winter 2026
  startDate        DateTime?
  endDate          DateTime?
  formStartDate    DateTime?
  formEndDate      DateTime?
  status           String    @default("DRAFT") // DRAFT | FORM_OPEN | FORM_CLOSED | SCHEDULED | ONGOING | COMPLETED | RESULT_PROCESSING | RESULT_PUBLISHED | CANCELLED
  description      String?   @db.Text
  instructions     String?   @db.Text
  notesheetId      String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  examType         ExamType?        @relation(fields: [examTypeId], references: [id])
  program          Program          @relation(fields: [programId], references: [id])
  notesheet        NoteSheet?       @relation(fields: [notesheetId], references: [id])
  formWindows      ExamFormWindow[]
  examForms        ExamForm[]
  schedules        ExamSchedule[]
  examSubjects     ExamSubject[]
  examFees         ExamFee[]
  lateFeeRules     ExamLateFeeRule[]
  centreAllocations ExamCentreAllocation[]
  seatAllocations  ExamSeatAllocation[]
  edpDuties        ExamEdpDuty[]

  @@index([examTypeId])
  @@index([programId])
  @@index([instituteId])
  @@index([departmentId])
  @@index([academicYearId])
  @@index([semesterId])
  @@index([status])
  @@index([notesheetId])
  @@index([createdAt])
}

model ExamSubject {
  id              String    @id @default(uuid())
  examId          String
  subjectId       String
  examType        String    @default("REGULAR")
  examDate        DateTime?
  durationMinutes Int       @default(180)
  maximumMarks    Decimal   @default(100) @db.Decimal(5, 2)
  passingMarks    Decimal   @default(40) @db.Decimal(5, 2)
  internalMarks   Decimal   @default(30) @db.Decimal(5, 2)
  externalMarks   Decimal   @default(70) @db.Decimal(5, 2)
  credits         Decimal   @default(3) @db.Decimal(4, 2)
  examMode        String    @default("OFFLINE") // OFFLINE | ONLINE | OTHER
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject         Subject   @relation(fields: [subjectId], references: [id])
  examFormSubjects ExamFormSubject[]

  @@unique([examId, subjectId, examType])
  @@index([examId])
  @@index([subjectId])
}

model ExamFee {
  id            String    @id @default(uuid())
  examId        String
  examType      String    // REGULAR | BACKLOG | SUPPLEMENTARY | REMEDIAL | RE_EXAM | IMPROVEMENT | SPECIAL
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("INR")
  isMandatory   Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([examType])
}

model ExamLateFeeRule {
  id              String    @id @default(uuid())
  examId          String
  calculationType String    @default("FIXED") // FIXED | PER_DAY | PERCENTAGE
  amount          Decimal   @db.Decimal(10, 2)
  maximumAmount   Decimal?  @db.Decimal(10, 2)
  gracePeriodDays Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([isActive])
}

model ExamFormWindow {
  id              String    @id @default(uuid())
  examId          String
  windowOpen      DateTime
  windowClose     DateTime
  lateWindowClose DateTime?
  examFee         Decimal   @default(0) @db.Decimal(10, 2)
  lateFee         Decimal   @default(0) @db.Decimal(10, 2)
  maxAttempts     Int       @default(1)
  status          String    @default("ACTIVE") // ACTIVE | CLOSED | UPCOMING
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  examForms ExamForm[]

  @@index([examId])
  @@index([status])
}

model ExamForm {
  id                   String    @id @default(uuid())
  examId               String
  studentId            String
  formNumber           String    @unique
  examFormWindowId     String?
  semesterId           String?
  attemptNumber        Int       @default(1)
  status               String    @default("DRAFT") // DRAFT | SUBMITTED | PAYMENT_PENDING | PAYMENT_COMPLETED | VERIFICATION_PENDING | VERIFIED | REJECTED | CANCELLED
  paymentStatus        String    @default("PENDING") // PENDING | COMPLETED | FAILED | WAIVED
  examFeeAmount        Decimal   @default(0) @db.Decimal(10, 2)
  lateFeeAmount        Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal   @default(0) @db.Decimal(10, 2)
  totalFee             Decimal   @default(0) @db.Decimal(10, 2)
  feePaid              Boolean   @default(false)
  paymentOrderId       String?
  paymentTransactionId String?
  paidAt               DateTime?
  submittedAt          DateTime?
  submittedBy          String?
  verifiedAt           DateTime?
  verifiedBy           String?
  verificationRemarks  String?
  returnedAt           DateTime?
  returnedBy           String?
  returnReason         String?
  rejectedAt           DateTime?
  rejectedBy           String?
  rejectionReason      String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  examFormWindow ExamFormWindow? @relation(fields: [examFormWindowId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  semester       Semester?       @relation(fields: [semesterId], references: [id])
  formSubjects   ExamFormSubject[]
  hallTicket     HallTicket?
  results        ExamResult[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId])
  @@index([studentId])
  @@index([formNumber])
  @@index([status])
  @@index([paymentStatus])
}

model ExamFormSubject {
  id                   String    @id @default(uuid())
  examFormId           String
  examinationSubjectId String?
  subjectId            String
  amount               Decimal   @default(0) @db.Decimal(10, 2)
  status               String    @default("ENROLLED") // ENROLLED | EXEMPTED | DROPPED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  examForm             ExamForm  @relation(fields: [examFormId], references: [id], onDelete: Cascade)
  examinationSubject   ExamSubject? @relation(fields: [examinationSubjectId], references: [id])
  subject              Subject   @relation(fields: [subjectId], references: [id])

  @@unique([examFormId, subjectId])
  @@index([examFormId])
  @@index([subjectId])
}

model ExamSchedule {
  id           String    @id @default(uuid())
  examId       String
  subjectId    String
  semesterId   String
  examDate     DateTime
  startTime    String    // HH:mm format
  endTime      String
  venue        String?
  invigilator  String?
  status       String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | POSTPONED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  results  ExamResult[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([examDate])
}

model ExamResult {
  id                  String    @id @default(uuid())
  examFormId          String
  studentId           String
  subjectId           String
  examScheduleId      String?
  internalMarks       Decimal?  @db.Decimal(6, 2)
  maxInternalMarks    Decimal?  @default(30) @db.Decimal(6, 2)
  externalMarks       Decimal?  @db.Decimal(6, 2)
  maxExternalMarks    Decimal?  @default(70) @db.Decimal(6, 2)
  practicalMarks      Decimal?  @db.Decimal(6, 2)
  maxPracticalMarks   Decimal?  @default(0) @db.Decimal(6, 2)
  marksObtained       Decimal?  @db.Decimal(6, 2)
  maxMarks            Decimal   @default(100) @db.Decimal(6, 2)
  grade               String?   // O, A+, A, B+, B, C, P, F, AB
  gradePoints         Decimal?  @db.Decimal(4, 2)
  isPassed            Boolean?
  isAbsent            Boolean   @default(false)
  isMalpractice       Boolean   @default(false)
  evaluationStatus    String    @default("PENDING") // PENDING | DRAFT | SUBMITTED | UNDER_REVIEW | VERIFIED | APPROVED | REVISED | RETURNED | REJECTED
  resultStatus        String    @default("PENDING") // PENDING | DECLARED | WITHHELD | CANCELLED
  publishedAt         DateTime?
  enteredByUserId     String?
  submittedByUserId   String?
  submittedAt         DateTime?
  evaluatedByUserId   String?
  evaluatedAt         DateTime?
  verifiedByUserId    String?
  verifiedAt          DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  originalMarks       Decimal?  @db.Decimal(6, 2)
  correctionReason    String?
  returnReason        String?
  correctedByUserId   String?
  correctedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  examForm     ExamForm      @relation(fields: [examFormId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])
  examSchedule ExamSchedule? @relation(fields: [examScheduleId], references: [id])

  @@unique([examFormId, subjectId])
  @@index([studentId])
  @@index([subjectId])
  @@index([resultStatus])
  @@index([evaluationStatus])
}

// --- FEES SECTION ---

model FeeHead {
  id            String   @id @default(uuid())
  code          String   @unique // TUITION, EXAM, HOSTEL, TRANSPORT, BONAFIDE, TRANSCRIPT, DEGREE
  name          String
  description   String?
  category      String   @default("ACADEMIC") // ACADEMIC | ADMISSION | EXAMINATION | HOSTEL | TRANSPORT | CERTIFICATE | LIBRARY | LABORATORY | STUDENT_ACTIVITY | OTHER
  defaultAmount Decimal? @db.Decimal(12, 2) @default(0)
  isMandatory   Boolean  @default(true)
  isOptional    Boolean  @default(false)
  isActive      Boolean  @default(true)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feeStructureItems FeeStructureItem[]
  feePaymentItems   FeePaymentItem[]
  studentFeeItems   StudentFeeItem[]
  invoiceItems      FeeInvoiceItem[]
  auditLogs         FeeHeadAuditLog[]
  lateFeeRules      LateFeeRule[]

  @@index([code])
  @@index([category])
  @@index([isActive])
  @@index([status])
}

model FeeHeadAuditLog {
  id                String   @id @default(uuid())
  feeHeadId         String
  action            String   // CREATED | UPDATED | ACTIVATED | DEACTIVATED
  performedByUserId String
  performedByName   String?
  details           String?
  createdAt         DateTime @default(now())

  feeHead           FeeHead  @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@index([feeHeadId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model FeeStructure {
  id                String    @id @default(uuid())
  structureCode     String?   @unique // e.g. FS-BTECH-CSE-S5-2026-V1
  instituteId       String?
  departmentId      String?
  programId         String
  semesterId        String
  academicYearCode  String    // e.g. "2026-27"
  academicYearId    String?
  studentCategoryId String?
  name              String
  description       String?
  totalAmount       Decimal   @db.Decimal(12, 2)
  dueDate           DateTime?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            String    @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  version           Int       @default(1)
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  institute    Institute?    @relation(fields: [instituteId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  program      Program       @relation(fields: [programId], references: [id])
  semester     Semester      @relation(fields: [semesterId], references: [id])
  items        FeeStructureItem[]
  accounts     StudentFeeAccount[]
  invoices     FeeInvoice[]
  auditLogs    FeeStructureAuditLog[]
  lateFeeRules LateFeeRule[]

  @@index([structureCode])
  @@index([instituteId])
  @@index([departmentId])
  @@index([programId])
  @@index([semesterId])
  @@index([academicYearCode])
  @@index([status])
}

model FeeStructureItem {
  id             String   @id @default(uuid())
  feeStructureId String
  feeHeadId      String
  amount         Decimal  @db.Decimal(12, 2)
  isMandatory    Boolean  @default(true)
  isOptional     Boolean  @default(false)
  frequency      String   @default("PER_SEMESTER") // ONE_TIME | PER_SEMESTER | PER_YEAR | MONTHLY | OTHER
  sequence       Int      @default(1)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])
  studentFeeItems StudentFeeItem[]

  @@unique([feeStructureId, feeHeadId])
  @@index([feeStructureId])
  @@index([feeHeadId])
}

model FeeStructureAuditLog {
  id                String   @id @default(uuid())
  feeStructureId    String
  action            String   // CREATED | UPDATED | DUPLICATED | ACTIVATED | DEACTIVATED | ITEM_ADDED | ITEM_UPDATED | ITEM_REMOVED
  performedByUserId String
  performedByName   String?
  details           String?
  createdAt         DateTime @default(now())

  feeStructure      FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model StudentFeeAccount {
  id               String   @id @default(uuid())
  studentId        String
  feeStructureId   String
  academicYearCode String
  totalDue         Decimal  @db.Decimal(12, 2)
  totalPaid        Decimal  @default(0) @db.Decimal(12, 2)
  totalDiscount    Decimal  @default(0) @db.Decimal(12, 2)
  totalWaived      Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue       Decimal  @db.Decimal(12, 2)
  status           String   @default("PENDING") // PENDING | PARTIALLY_PAID | PAID | OVERDUE | WAIVED | CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  items        StudentFeeItem[]
  invoices     FeeInvoice[]
  payments     FeePayment[]
  discounts    FeeDiscount[]
  refunds      FeeRefund[]
  auditLogs    StudentFeeAccountAuditLog[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
}

model StudentFeeItem {
  id                  String   @id @default(uuid())
  studentFeeAccountId String
  feeHeadId           String
  feeStructureItemId  String?
  amount              Decimal  @db.Decimal(12, 2)
  paidAmount          Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  waivedAmount        Decimal  @default(0) @db.Decimal(12, 2)
  outstandingAmount   Decimal  @db.Decimal(12, 2)
  status              String   @default("PENDING") // PENDING | PARTIALLY_PAID | PAID | WAIVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studentFeeAccount   StudentFeeAccount @relation(fields: [studentFeeAccountId], references: [id], onDelete: Cascade)
  feeHead             FeeHead           @relation(fields: [feeHeadId], references: [id])
  feeStructureItem    FeeStructureItem? @relation(fields: [feeStructureItemId], references: [id])
  invoiceItems        FeeInvoiceItem[]

  @@unique([studentFeeAccountId, feeHeadId])
  @@index([studentFeeAccountId])
  @@index([feeHeadId])
  @@index([status])
}

model StudentFeeAccountAuditLog {
  id                  String   @id @default(uuid())
  studentFeeAccountId String
  action              String   // FEE_ASSIGNED | DUPLICATE_ATTEMPT | ACCOUNT_CREATED | STATUS_CHANGED | FEE_ITEM_CREATED
  performedByUserId   String
  performedByName     String?
  details             String?
  createdAt           DateTime @default(now())

  studentFeeAccount   StudentFeeAccount @relation(fields: [studentFeeAccountId], references: [id], onDelete: Cascade)

  @@index([studentFeeAccountId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model FeeInvoice {
  id                  String             @id @default(uuid())
  invoiceNumber       String             @unique // e.g. SSIU/FEE/2026-27/000001
  studentId           String
  studentFeeAccountId String
  feeStructureId      String
  academicYearId      String?
  academicYearCode    String
  semesterId          String
  invoiceDate         DateTime           @default(now())
  dueDate             DateTime
  subtotal            Decimal            @db.Decimal(12, 2)
  discountAmount      Decimal            @default(0) @db.Decimal(12, 2)
  waiverAmount        Decimal            @default(0) @db.Decimal(12, 2)
  lateFeeAmount       Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal            @db.Decimal(12, 2)
  status              String             @default("ISSUED") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  remarks             String?
  issuedAt            DateTime?
  cancelledAt         DateTime?
  cancelledBy         String?
  cancellationReason  String?
  createdBy           String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFeeAccount   StudentFeeAccount  @relation(fields: [studentFeeAccountId], references: [id], onDelete: Cascade)
  feeStructure        FeeStructure       @relation(fields: [feeStructureId], references: [id])
  items               FeeInvoiceItem[]
  auditLogs           FeeInvoiceAuditLog[]
  paymentOrders       PaymentOrder[]
  paymentTransactions PaymentTransaction[]
  paymentReceipts     PaymentReceipt[]
  lateFeeRecords      LateFeeRecord[]

  @@index([studentId])
  @@index([studentFeeAccountId])
  @@index([feeStructureId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model FeeInvoiceItem {
  id                String          @id @default(uuid())
  invoiceId         String
  feeHeadId         String
  studentFeeItemId  String?
  description       String?
  amount            Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invoice           FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead           FeeHead         @relation(fields: [feeHeadId], references: [id])
  studentFeeItem    StudentFeeItem? @relation(fields: [studentFeeItemId], references: [id])

  @@index([invoiceId])
  @@index([feeHeadId])
  @@index([studentFeeItemId])
}

model FeeInvoiceAuditLog {
  id                String          @id @default(uuid())
  invoiceId         String
  action            String          // CREATED | ISSUED | UPDATED | CANCELLED | DOWNLOADED | PRINTED
  performedByUserId String
  performedByName   String?
  details           String?
  createdAt         DateTime        @default(now())

  invoice           FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model PaymentOrder {
  id              String               @id @default(uuid())
  orderNumber     String               @unique // e.g. ORD-2026-000001
  invoiceId       String
  studentId       String
  gateway         String               @default("RAZORPAY")
  gatewayOrderId  String?
  amount          Decimal              @db.Decimal(12, 2)
  currency        String               @default("INR")
  status          String               @default("PENDING") // CREATED | PENDING | PAID | FAILED | CANCELLED | EXPIRED
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  invoice         FeeInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions    PaymentTransaction[]

  @@index([invoiceId])
  @@index([studentId])
  @@index([gatewayOrderId])
  @@index([status])
  @@index([createdAt])
}

model PaymentTransaction {
  id                       String            @id @default(uuid())
  paymentOrderId           String?
  invoiceId                String
  studentId                String
  transactionNumber        String            @unique // e.g. TXN-2026-000001
  gateway                  String            @default("RAZORPAY")
  gatewayPaymentId         String?           @unique
  gatewayOrderId           String?
  amount                   Decimal           @db.Decimal(12, 2)
  currency                 String            @default("INR")
  paymentMethod            String            @default("UPI") // UPI | CARD | NETBANKING | WALLET | ONLINE | OTHER
  status                   String            @default("SUCCESS") // INITIATED | SUCCESS | FAILED | CANCELLED | REFUNDED
  failureReason            String?
  gatewayResponseReference String?
  paidAt                   DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  paymentOrder             PaymentOrder?     @relation(fields: [paymentOrderId], references: [id])
  invoice                  FeeInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student                  Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  auditLogs                PaymentAuditLog[]
  receipt                  PaymentReceipt?

  @@index([paymentOrderId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([gatewayPaymentId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
}

model PaymentAuditLog {
  id                String              @id @default(uuid())
  transactionId     String?
  paymentOrderId    String?
  action            String              // ORDER_CREATED | VERIFICATION_ATTEMPT | PAYMENT_SUCCESS | PAYMENT_FAILURE | PAYMENT_CANCELLED | DUPLICATE_ATTEMPT | UNAUTHORIZED_ATTEMPT | WEBHOOK_RECEIVED
  performedByUserId String?
  performedByName   String?
  details           String?
  ipAddress         String?
  createdAt         DateTime            @default(now())

  transaction       PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([paymentOrderId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model PaymentReceipt {
  id                   String                   @id @default(uuid())
  receiptNumber        String                   @unique // e.g. SSIU/REC/2026-27/000001
  paymentTransactionId String                   @unique
  invoiceId            String
  studentId            String
  amount               Decimal                  @db.Decimal(12, 2)
  totalPaidAfter       Decimal                  @db.Decimal(12, 2)
  balanceRemaining     Decimal                  @db.Decimal(12, 2)
  paymentDate          DateTime                 @default(now())
  paymentMode          String                   @default("ONLINE")
  gateway              String                   @default("RAZORPAY")
  status               String                   @default("ISSUED") // ISSUED | CANCELLED
  pdfReference         String?
  generatedAt          DateTime                 @default(now())
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  paymentTransaction   PaymentTransaction       @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  invoice              FeeInvoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student              Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  auditLogs            PaymentReceiptAuditLog[]

  @@index([receiptNumber])
  @@index([paymentTransactionId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([paymentDate])
  @@index([createdAt])
}

model PaymentReceiptAuditLog {
  id                String         @id @default(uuid())
  receiptId         String
  action            String         // GENERATED | VIEWED | DOWNLOADED | PRINTED
  performedByUserId String?
  performedByName   String?
  details           String?
  createdAt         DateTime       @default(now())

  receipt           PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([performedByUserId])
  @@index([createdAt])
}

// ─── Phase 7: Late Fee Management ──────────────────────────────────────────

model LateFeeRule {
  id                String    @id @default(uuid())
  name              String
  description       String?
  feeStructureId    String?
  feeHeadId         String?
  calculationType   String    @default("PER_DAY") // FIXED | PER_DAY | PERCENTAGE | ONE_TIME
  amount            Decimal   @db.Decimal(12, 2)  // flat amount or per-day amount or percentage value
  maximumAmount     Decimal?  @db.Decimal(12, 2)  // cap on total late fee
  gracePeriodDays   Int       @default(0)          // days after due date before late fee begins
  applyOnOutstanding Boolean  @default(false)      // true = % on outstanding; false = % on invoice total
  isActive          Boolean   @default(true)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  feeStructure      FeeStructure?   @relation(fields: [feeStructureId], references: [id])
  feeHead           FeeHead?        @relation(fields: [feeHeadId], references: [id])
  lateFeeRecords    LateFeeRecord[]

  @@index([feeStructureId])
  @@index([feeHeadId])
  @@index([isActive])
  @@index([createdAt])
}

model LateFeeRecord {
  id               String    @id @default(uuid())
  invoiceId        String
  ruleId           String
  calculationDate  DateTime  @default(now())
  overdueDays      Int       @default(0)
  baseAmount       Decimal   @db.Decimal(12, 2)
  lateFeeAmount    Decimal   @db.Decimal(12, 2)
  status           String    @default("APPLIED") // APPLIED | REVERSED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoice          FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rule             LateFeeRule @relation(fields: [ruleId], references: [id])

  @@index([invoiceId])
  @@index([ruleId])
  @@index([status])
  @@index([calculationDate])
  @@index([createdAt])
}

// ─── CENTRALIZED UNIVERSITY NOTESHEET ENGINE (PHASE 1) ───────────────────────

model NoteSheet {
  id                     String    @id @default(uuid())
  notesheetNumber        String    @unique // e.g. SIT-NOTESHEET-0826-001
  notesheetType          String    @default("Administrative") // Administrative | Academic | Financial | Purchase | HR | Student Matter | Examination | Hostel | Infrastructure | IT / Technical | Maintenance | Event | Legal / Compliance | Other
  visibility             String    @default("NORMAL") // NORMAL | CONFIDENTIAL | HIGHLY_CONFIDENTIAL
  title                  String    // Subject / Title
  subject                String    // Alias
  department             String    // EXAM | HOSTEL | ACCOUNTS | ADMIN | ADMISSION | TRANSPORT | STUDENT_SECTION | LIBRARY | MAINTENANCE | IQAC | REGISTRAR | CSE | IT | etc.
  section                String?   // e.g. Conduct, Evaluation, Mess, Boys Hostel, Block A
  referenceNumber        String?   // Memo / Circular reference
  date                   DateTime  @default(now())
  priority               String    @default("NORMAL") // NORMAL | IMPORTANT | URGENT | IMMEDIATE
  description            String?   @db.Text
  proposal               String    @db.Text
  purposeJustification   String    @db.Text
  financialRequirement   Boolean   @default(false)
  budgetRequired         Boolean   @default(false)
  estimatedCost          Decimal   @default(0) @db.Decimal(12, 2)
  amountInWords          String?
  financialImpact        String?   @db.Text
  currency               String    @default("INR")
  expenseCategory        String?
  budgetHead             String?
  budgetAvailable        Boolean   @default(false)
  requestedAmount        Decimal?  @db.Decimal(12, 2)
  approvedAmount         Decimal?  @db.Decimal(12, 2)
  approvedAmountRemarks  String?
  approvedAmountByUserId String?
  approvedAmountByName   String?
  approvedAmountAt       DateTime?
  financeRemarks         String?   @db.Text
  procurementRequirement String?
  supportingFinancialDoc String?
  vendorQuotation        String?
  requiredDate           DateTime?
  workflowDueDate        DateTime?
  isOverdue              Boolean   @default(false)
  previousNoteSheetId    String?
  previousNoteSheetNumber String?
  relatedNoteSheetIds    String?
  status                 String    @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | PENDING_APPROVAL | FORWARDED | CLARIFICATION_REQUIRED | RETURNED | APPROVED | ACTION_PENDING | ACTION_IN_PROGRESS | ACTION_COMPLETED | REJECTED | CLOSED | CANCELLED | REOPENED
  currentOffice          String    @default("CREATOR") // HOD | HOI | REGISTRAR | VICE_PRESIDENT | ACCOUNTS | EXAM_CELL | HOSTEL_ADMIN | COMPLETED | CREATOR
  currentHandlerId       String?   // User UUID responsible
  decision               String?   // APPROVED | REJECTED | RETURNED | CLARIFICATION_REQUIRED
  decisionDate           DateTime?
  decisionReason         String?   @db.Text
  approvedByUserId       String?
  approvedByName         String?
  approvedAt             DateTime?
  rejectedByUserId       String?
  rejectedByName         String?
  rejectedAt             DateTime?
  returnedByUserId       String?
  returnedByName         String?
  returnedAt             DateTime?
  actionTakenSummary     String?   @db.Text
  actionTakenByUserId    String?
  actionTakenByName      String?
  actionTakenAt          DateTime?
  actionTakenProofUrl    String?
  reopenedReason         String?   @db.Text
  reopenedByUserId       String?
  reopenedByName         String?
  reopenedAt             DateTime?
  closedByUserId         String?
  closedByName           String?
  closedAt               DateTime?
  createdByUserId        String
  createdByName          String
  createdByRole          String
  contactNumber          String?
  version                Int       @default(1)
  instituteId            String?
  instituteName          String?
  departmentId           String?   // Optional FK to academic department if applicable
  departmentName         String?
  periodMMYY             String?   // e.g. 0826
  sequenceNumber         Int?      @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  createdByUser          User      @relation("NoteSheetCreator", fields: [createdByUserId], references: [id])
  items                  NoteSheetEstimateItem[]
  attachments            NoteSheetAttachment[]
  history                NoteSheetHistory[]
  complianceItems        NoteSheetComplianceItem[]
  clarifications         NoteSheetClarification[]
  exams                  Exam[]

  @@index([notesheetNumber])
  @@index([instituteId, periodMMYY, sequenceNumber])
  @@index([department])
  @@index([section])
  @@index([status])
  @@index([priority])
  @@index([visibility])
  @@index([createdByUserId])
  @@index([currentOffice])
  @@index([createdAt])
}

model NoteSheetEstimateItem {
  id          String    @id @default(uuid())
  notesheetId String
  itemName    String
  description String?
  quantity    Decimal   @default(1) @db.Decimal(10, 2)
  unit        String    @default("Nos")
  rate        Decimal   @default(0) @db.Decimal(12, 2)
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  sequence    Int       @default(1)
  createdAt   DateTime  @default(now())

  notesheet   NoteSheet @relation(fields: [notesheetId], references: [id], onDelete: Cascade)

  @@index([notesheetId])
}

model NoteSheetAttachment {
  id               String    @id @default(uuid())
  notesheetId      String
  fileName         String
  fileType         String    // PDF, DOC, DOCX, XLS, XLSX, JPG, JPEG, PNG
  fileSize         Int       @default(0) // In bytes
  fileUrl          String
  documentCategory String?   // Quotation, Proposal, Estimate, Bill, Approval Letter, etc.
  version          Int       @default(1)
  uploadedByUserId String
  uploadedByName   String
  createdAt        DateTime  @default(now())

  notesheet        NoteSheet @relation(fields: [notesheetId], references: [id], onDelete: Cascade)

  @@index([notesheetId])
  @@index([uploadedByUserId])
}

model NoteSheetHistory {
  id               String    @id @default(uuid())
  notesheetId      String
  fromUserId       String?
  fromUserName     String
  fromUserRole     String
  toOffice         String
  action           String    // CREATED | SUBMITTED | REVIEWED | FORWARDED | RETURNED | APPROVED | REJECTED | CLOSED | ATTACHMENT_ADDED | EDITED
  remarks          String    @db.Text
  attachmentUrl    String?
  timestamp        DateTime  @default(now())
  createdAt        DateTime  @default(now())

  notesheet        NoteSheet @relation(fields: [notesheetId], references: [id], onDelete: Cascade)

  @@index([notesheetId])
  @@index([action])
  @@index([fromUserId])
  @@index([createdAt])
}

model NoteSheetComplianceItem {
  id               String    @id @default(uuid())
  notesheetId      String
  actionDescription String   @db.Text
  responsibleDept  String
  responsibleUserId String?
  responsibleUserName String?
  deadline         DateTime?
  status           String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | OVERDUE
  completedAt      DateTime?
  remarks          String?   @db.Text
  proofUrl         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notesheet        NoteSheet @relation(fields: [notesheetId], references: [id], onDelete: Cascade)

  @@index([notesheetId])
  @@index([status])
}

model NoteSheetClarification {
  id               String    @id @default(uuid())
  notesheetId      String
  requestedByUserId String
  requestedByName  String
  requestedByRole  String
  query            String    @db.Text
  requestedAt      DateTime  @default(now())
  response         String?   @db.Text
  respondedByUserId String?
  respondedByName  String?
  respondedAt      DateTime?
  status           String    @default("PENDING") // PENDING | ANSWERED

  notesheet        NoteSheet @relation(fields: [notesheetId], references: [id], onDelete: Cascade)

  @@index([notesheetId])
  @@index([status])
}

model NoteSheetWorkflowMatrix {
  id               String    @id @default(uuid())
  instituteId      String?
  departmentId     String?
  notesheetType    String?
  financialRequired Boolean  @default(false)
  minAmount        Decimal?  @db.Decimal(12, 2)
  maxAmount        Decimal?  @db.Decimal(12, 2)
  sequence         Int       @default(1)
  authorityRole    String
  specificUserId   String?
  isMandatory      Boolean   @default(true)
  isParallel       Boolean   @default(false)
  parallelGroupId  String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([instituteId, departmentId, notesheetType])
}

model NoteSheetSequence {
  id               String    @id @default(uuid())
  instituteCode    String
  periodMMYY       String    // e.g. 0826
  lastSequence     Int       @default(0)
  updatedAt        DateTime  @updatedAt

  @@unique([instituteCode, periodMMYY])
}

model FeePayment {
  id               String    @id @default(uuid())
  receiptNo        String    @unique   // FEE-2024-000001
  feeAccountId     String
  amount           Decimal   @db.Decimal(12, 2)
  paymentMode      String    // CASH | CHEQUE | DD | ONLINE | UPI | NEFT | RTGS
  transactionRef   String?
  paymentDate      DateTime  @default(now())
  collectedByUserId String?
  status           String    @default("CONFIRMED") // CONFIRMED | PENDING | FAILED | REFUNDED
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id])
  items      FeePaymentItem[]
  refunds    FeeRefund[]

  @@index([feeAccountId])
  @@index([paymentDate])
  @@index([status])
}

model FeePaymentItem {
  id          String  @id @default(uuid())
  paymentId   String
  feeHeadId   String
  amount      Decimal @db.Decimal(10, 2)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@unique([paymentId, feeHeadId])
}

model FeeDiscount {
  id             String   @id @default(uuid())
  feeAccountId   String
  discountType   String   // SCHOLARSHIP | MERIT | STAFF_WARD | GOVERNMENT | MANAGEMENT | OTHER
  description    String?
  amount         Decimal  @db.Decimal(10, 2)
  approvedByUserId String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)

  @@index([feeAccountId])
}

model FeeRefund {
  id             String    @id @default(uuid())
  feeAccountId   String
  paymentId      String
  refundAmount   Decimal   @db.Decimal(10, 2)
  reason         String
  refundMode     String    @default("ONLINE")
  processedAt    DateTime?
  processedByUserId String?
  status         String    @default("PENDING") // PENDING | PROCESSED | REJECTED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id])
  payment    FeePayment        @relation(fields: [paymentId], references: [id])

  @@index([feeAccountId])
  @@index([status])
}

model PaymentReconciliation {
  id                    String    @id @default(uuid())
  reconciliationNumber  String    @unique // REC-REC-2026-000001
  paymentTransactionId  String?
  gatewayPaymentId      String?
  transactionRef        String?
  studentId             String?
  reconciliationType    String    @default("GATEWAY") // GATEWAY | BANK_TRANSFER | MANUAL
  gatewayAmount         Decimal?  @db.Decimal(12, 2)
  erpAmount             Decimal?  @db.Decimal(12, 2)
  discrepancyAmount     Decimal?  @default(0) @db.Decimal(12, 2)
  paymentDate           DateTime  @default(now())
  paymentMode           String?   // UPI | CARD | NET_BANKING | BANK_TRANSFER | CASH | CHEQUE | OTHER
  gatewayStatus         String?   // SUCCESS | FAILED | PENDING
  erpStatus             String?   // SUCCESS | PENDING | NOT_FOUND
  reconciliationStatus  String    @default("PENDING") // MATCHED | PENDING | MISMATCH | RECONCILED
  remarks               String?
  reconciledByUserId    String?
  reconciledAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([reconciliationNumber])
  @@index([paymentTransactionId])
  @@index([gatewayPaymentId])
  @@index([reconciliationStatus])
  @@index([paymentDate])
}


// ──────────────────────────────────────────────────────────────────────────────
// 8. STORE, PURCHASE & ASSET MANAGEMENT

// ──────────────────────────────────────────────────────────────────────────────

// --- CENTRAL STORE ---

model ItemCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  items    ItemMaster[]

  @@index([parentId])
}

model UnitOfMeasurement {
  id           String   @id @default(uuid())
  code         String   @unique   // NOS, KG, LTR, PCS, BOX, MTR, SET
  name         String
  abbreviation String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  items ItemMaster[]
}

model ItemMaster {
  id              String   @id @default(uuid())
  itemCode        String   @unique
  name            String
  description     String?
  categoryId      String
  unitId          String
  minStockLevel   Int      @default(0)
  reorderLevel    Int      @default(5)
  reorderQuantity Int      @default(10)
  currentStock    Int      @default(0)
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  location        String?  // Storage location / rack
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ItemCategory  @relation(fields: [categoryId], references: [id])
  unit            UnitOfMeasurement @relation(fields: [unitId], references: [id])
  stockLedger     StockLedger[]
  stockAdjustments StockAdjustment[]
  stockIssues     StockIssue[]
  stockReturns    StockReturn[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  quotationItems       QuotationItem[]

  @@index([categoryId])
  @@index([currentStock])
}

model StockLedger {
  id              String   @id @default(uuid())
  itemId          String
  transactionType String   // STOCK_IN | STOCK_OUT | ADJUSTMENT | ISSUE | RETURN | TRANSFER
  quantity        Int
  balanceAfter    Int
  referenceType   String?  // GRN | ISSUE | RETURN | ADJUSTMENT | PURCHASE_ORDER
  referenceId     String?
  unitPrice       Decimal? @db.Decimal(12, 2)
  totalValue      Decimal? @db.Decimal(12, 2)
  remarks         String?
  performedByUserId String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  item ItemMaster @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([transactionType])
  @@index([transactionDate])
}

model StockAdjustment {
  id              String   @id @default(uuid())
  adjustmentNo    String   @unique    // ADJ-2024-000001
  itemId          String
  adjustmentType  String   // DAMAGE | LOSS | CORRECTION | EXPIRY | TRANSFER
  quantityBefore  Int
  quantityChanged Int      // positive or negative
  quantityAfter   Int
  reason          String
  approvedByUserId String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adjustmentDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item ItemMaster @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([adjustmentType])
  @@index([status])
}

model StockIssue {
  id            String    @id @default(uuid())
  issueNo       String    @unique    // ISS-2024-000001
  itemId        String
  quantityIssued Int
  issuedToUserId String?
  issuedToDepartment String?
  issuedByUserId String
  purpose       String?
  issueDate     DateTime  @default(now())
  expectedReturnDate DateTime?
  status        String    @default("ISSUED") // ISSUED | PARTIALLY_RETURNED | FULLY_RETURNED | LOST
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  item         ItemMaster  @relation(fields: [itemId], references: [id])
  issuedToUser User?       @relation("IssuedToUser", fields: [issuedToUserId], references: [id])
  issuedByUser User        @relation("IssuedByUser", fields: [issuedByUserId], references: [id])
  returns      StockReturn[]

  @@index([itemId])
  @@index([issuedToUserId])
  @@index([status])
}

model StockReturn {
  id               String   @id @default(uuid())
  returnNo         String   @unique   // RET-2024-000001
  issueId          String
  itemId           String
  quantityReturned Int
  returnCondition  String   @default("GOOD") // GOOD | DAMAGED | PARTIAL
  returnDate       DateTime @default(now())
  receivedByUserId String?
  remarks          String?
  createdAt        DateTime @default(now())

  issue      StockIssue @relation(fields: [issueId], references: [id])
  item       ItemMaster @relation(fields: [itemId], references: [id])

  @@index([issueId])
  @@index([itemId])
}

// --- PURCHASE MODULE ---

model Vendor {
  id            String   @id @default(uuid())
  vendorCode    String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNo         String?
  panNo         String?
  bankAccount   String?
  bankIfsc      String?
  bankName      String?
  rating        Int      @default(3) // 1-5 star rating
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]

  @@index([status])
}

model PurchaseRequest {
  id                  String    @id @default(uuid())
  requestNo           String    @unique    // PR-2024-000001
  requestedByUserId   String
  departmentId        String?
  instituteId         String?
  requestDate         DateTime  @default(now())
  requiredByDate      DateTime?
  priority            String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status              String    @default("DRAFT")
  // DRAFT | SUBMITTED | HOD_VERIFIED | HOI_APPROVED | PURCHASE_PROCESSING | PO_ISSUED | COMPLETED | REJECTED | CANCELLED
  remarks             String?
  workflowInstanceId  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requestedByUser User     @relation("RequestedByUser", fields: [requestedByUserId], references: [id])
  items           PurchaseRequestItem[]
  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]

  @@index([requestedByUserId])
  @@index([status])
  @@index([requestDate])
}

model PurchaseRequestItem {
  id                String   @id @default(uuid())
  purchaseRequestId String
  itemId            String
  quantityRequested Int
  estimatedUnitPrice Decimal? @db.Decimal(12, 2)
  specifications    String?
  remarks           String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item            ItemMaster      @relation(fields: [itemId], references: [id])

  @@index([purchaseRequestId])
  @@index([itemId])
}

model Quotation {
  id                String    @id @default(uuid())
  quotationNo       String    @unique   // QT-2024-000001
  purchaseRequestId String?
  vendorId          String
  quotationDate     DateTime  @default(now())
  validUntil        DateTime?
  totalAmount       Decimal   @default(0) @db.Decimal(12, 2)
  termsConditions   String?
  deliveryDays      Int?
  isSelected        Boolean   @default(false)
  status            String    @default("RECEIVED") // RECEIVED | UNDER_EVALUATION | SELECTED | REJECTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  items           QuotationItem[]

  @@index([purchaseRequestId])
  @@index([vendorId])
  @@index([status])
}

model QuotationItem {
  id           String   @id @default(uuid())
  quotationId  String
  itemId       String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  gstPercent   Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount    Decimal  @default(0) @db.Decimal(10, 2)
  remarks      String?

  quotation Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      ItemMaster @relation(fields: [itemId], references: [id])

  @@index([quotationId])
}

model PurchaseOrder {
  id                String    @id @default(uuid())
  poNo              String    @unique    // PO-2024-000001
  purchaseRequestId String?
  vendorId          String
  orderDate         DateTime  @default(now())
  expectedDelivery  DateTime?
  totalAmount       Decimal   @default(0) @db.Decimal(12, 2)
  gstAmount         Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal   @default(0) @db.Decimal(12, 2)
  terms             String?
  status            String    @default("DRAFT")
  // DRAFT | APPROVED | SENT_TO_VENDOR | PARTIALLY_RECEIVED | FULLY_RECEIVED | CANCELLED | CLOSED
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  invoices        PurchaseInvoice[]

  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  gstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal  @default(0) @db.Decimal(10, 2)
  quantityReceived Int     @default(0)
  remarks         String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          ItemMaster    @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String    @id @default(uuid())
  grnNo           String    @unique    // GRN-2024-000001
  purchaseOrderId String
  receivedDate    DateTime  @default(now())
  receivedByUserId String?
  vehicleNo       String?
  dcNo            String?   // Delivery Challan No
  invoiceRef      String?
  remarks         String?
  status          String    @default("RECEIVED") // RECEIVED | VERIFIED | REJECTED | PARTIAL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receivedDate])
}

model GoodsReceiptItem {
  id             String   @id @default(uuid())
  grnId          String
  itemId         String
  quantityOrdered  Int
  quantityReceived Int
  quantityRejected Int    @default(0)
  unitPrice      Decimal  @db.Decimal(12, 2)
  condition      String   @default("GOOD") // GOOD | DAMAGED | EXPIRED
  remarks        String?

  grn  GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item ItemMaster   @relation(fields: [itemId], references: [id])

  @@index([grnId])
  @@index([itemId])
}

model PurchaseInvoice {
  id              String    @id @default(uuid())
  invoiceNo       String    @unique
  vendorInvoiceNo String?
  purchaseOrderId String
  vendorId        String
  invoiceDate     DateTime
  dueDate         DateTime?
  subtotal        Decimal   @db.Decimal(12, 2)
  gstAmount       Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal   @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  balanceAmount   Decimal   @db.Decimal(12, 2)
  paymentStatus   String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  status          String    @default("RECEIVED") // RECEIVED | VERIFIED | APPROVED | PAID | REJECTED
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  vendor        Vendor        @relation(fields: [vendorId], references: [id])

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([paymentStatus])
}

// --- ASSET & INVENTORY MANAGEMENT (CENTRALIZED UNIVERSITY MODULE) ---

model AssetCategory {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  categoryType     String    @default("IT_EQUIPMENT") // IT_EQUIPMENT | OFFICE_EQUIPMENT | FURNITURE | STATIONERY_CONSUMABLES | PHYSICAL_RECORDS | LAB_TECHNICAL | FACILITY_ELECTRICAL
  description      String?
  parentId         String?
  depreciationRate Decimal   @default(0) @db.Decimal(5, 2) // % per year
  usefulLifeYears  Int       @default(5)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parent           AssetCategory?    @relation("AssetCategoryHierarchy", fields: [parentId], references: [id])
  children         AssetCategory[]   @relation("AssetCategoryHierarchy")
  assets           Asset[]
  items            InventoryItem[]

  @@index([parentId])
  @@index([categoryType])
}

model InventoryLocation {
  id             String    @id @default(uuid())
  instituteId    String
  departmentId   String?
  building       String
  block          String?
  floor          String
  roomNo         String
  roomType       String    @default("LAB") // CLASSROOM | LAB | FACULTY_ROOM | STORE_ROOM | OFFICE | ARCHIVE | LIBRARY
  labName        String?
  rackNumber     String?
  shelfNumber    String?
  drawerNumber   String?
  boxNumber      String?
  custodianName  String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assets         Asset[]
  stockBalances  StockBalance[]
  physicalFiles  PhysicalFileRecord[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([building, roomNo])
}

model InventoryItem {
  id               String    @id @default(uuid())
  itemCode         String    @unique // e.g. IT-PC, STN-A4, FURN-CHAIR
  name             String
  categoryId       String
  subcategory      String?
  unit             String    @default("PCS") // PCS | BOX | PACKET | REAM | SET | BOTTLE | ROLL | KG | LITRE | OTHER
  isConsumable     Boolean   @default(false)
  minimumStockLevel Decimal  @default(10) @db.Decimal(10, 2)
  reorderLevel     Decimal   @default(25) @db.Decimal(10, 2)
  standardRate     Decimal?  @db.Decimal(10, 2)
  description      String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category         AssetCategory      @relation(fields: [categoryId], references: [id])
  stockBalances    StockBalance[]
  transactions     StockTransaction[]

  @@index([categoryId])
  @@index([isConsumable])
}

model Asset {
  id               String    @id @default(uuid())
  assetTag         String    @unique // e.g. SIT-CE-PC-0001, SIT-CE-MON-0001
  name             String
  description      String?
  categoryId       String
  instituteId      String
  departmentId     String?
  locationId       String?
  serialNo         String?
  modelNo          String?
  manufacturer     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?  @db.Decimal(12, 2)
  currentValue     Decimal?  @db.Decimal(12, 2)
  usefulLifeYears  Int       @default(5)
  depreciationRate Decimal?  @db.Decimal(5, 2)
  warrantyStart    DateTime?
  warrantyExpiry   DateTime?
  vendor           String?
  poNo             String?   // Linked Purchase Order
  invoiceRef       String?   // Invoice number
  location         String?   // Free-text location summary
  buildingBlock    String?
  floor            String?
  roomNo           String?
  assignedToUserId String?
  assignedToName   String?
  assignedDeptId   String?
  assetCondition   String    @default("GOOD") // NEW | EXCELLENT | GOOD | FAIR | POOR | DAMAGED
  status           String    @default("ACTIVE")
  // ACTIVE | IN_STORE | ASSIGNED | UNDER_MAINTENANCE | DAMAGED | LOST | TRANSFERRED | DISPOSED | RETIRED
  cpuConfigJson    String?   @db.Text // Embedded JSON specs for Desktop/Server CPUs
  qrCodeData       String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category         AssetCategory       @relation(fields: [categoryId], references: [id])
  inventoryLocation InventoryLocation? @relation(fields: [locationId], references: [id])
  assignments      AssetAssignment[]
  transfers        AssetTransfer[]
  maintenanceLogs  AssetMaintenance[]
  disposals        AssetDisposal[]
  verificationLogs PhysicalVerificationLog[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([assetTag])
}

model AssetAssignment {
  id                 String    @id @default(uuid())
  assetId            String
  assignedToUserId   String?
  assignedToName     String
  assignedToEmpCode  String?
  assignedToDeptId   String?
  assignedToDeptName String?
  assignedByUserId   String?
  assignedByName     String?
  location           String?
  roomNo             String?
  assignmentDate     DateTime  @default(now())
  expectedReturnDate DateTime?
  returnDate         DateTime?
  conditionAtIssue   String    @default("GOOD")
  conditionAtReturn  String?
  purpose            String?
  status             String    @default("ACTIVE") // ACTIVE | RETURNED | TRANSFERRED
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedToUser     User?     @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  @@index([assetId])
  @@index([assignedToUserId])
  @@index([status])
}

model AssetTransfer {
  id                  String    @id @default(uuid())
  transferNo          String    @unique // TRF-2026-000001
  assetId             String
  fromInstituteId     String
  toInstituteId       String
  fromDeptId          String?
  toDeptId            String?
  fromLocation        String?
  toLocation          String?
  fromCustodian       String?
  toCustodian         String?
  transferDate        DateTime  @default(now())
  transferredByUserId String?
  transferredByName   String?
  authorizedByName    String?
  receivedByUserId    String?
  receivedByName      String?
  reason              String?
  status              String    @default("COMPLETED") // PENDING | APPROVED | COMPLETED | CANCELLED
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asset               Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
}

model AssetMaintenance {
  id                 String    @id @default(uuid())
  maintenanceNo      String    @unique // MNT-2026-000001
  assetId            String
  maintenanceType    String    @default("CORRECTIVE") // PREVENTIVE | CORRECTIVE | BREAKDOWN | AMC | CALIBRATION
  issueDescription   String    @db.Text
  reportedByUserId   String?
  reportedByName     String
  reportedDate       DateTime  @default(now())
  scheduledDate      DateTime?
  completedDate      DateTime?
  vendorTechnician   String?
  estimatedCost      Decimal?  @db.Decimal(10, 2)
  actualCost         Decimal?  @db.Decimal(10, 2)
  partsReplaced      String?
  status             String    @default("REPORTED")
  // REPORTED | ASSIGNED | IN_PROGRESS | WAITING_PARTS | COMPLETED | CANCELLED
  remarks            String?
  documentUrl        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([maintenanceType])
}

model AssetDisposal {
  id                 String    @id @default(uuid())
  disposalNo         String    @unique // DIS-2026-000001
  assetId            String    @unique // One disposal per asset
  disposalMethod     String    @default("SCRAPPED") // AUCTION | SCRAPPED | DONATED | SOLD | WRITTEN_OFF
  disposalDate       DateTime  @default(now())
  bookValue          Decimal?  @db.Decimal(10, 2)
  disposalValue      Decimal?  @db.Decimal(10, 2)
  buyerName          String?
  reason             String    @db.Text
  approvedByUserId   String?
  approvedByName     String?
  approvedAt         DateTime?
  status             String    @default("PROPOSED") // PROPOSED | UNDER_APPROVAL | APPROVED | DISPOSED | CANCELLED
  remarks            String?
  documentUrl        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([disposalDate])
}

model StockBalance {
  id                 String    @id @default(uuid())
  itemId             String
  instituteId        String
  departmentId       String?
  locationId         String?
  openingQuantity    Decimal   @default(0) @db.Decimal(10, 2)
  receivedQuantity   Decimal   @default(0) @db.Decimal(10, 2)
  issuedQuantity     Decimal   @default(0) @db.Decimal(10, 2)
  returnedQuantity   Decimal   @default(0) @db.Decimal(10, 2)
  currentBalance     Decimal   @default(0) @db.Decimal(10, 2)
  minimumStockLevel  Decimal   @default(10) @db.Decimal(10, 2)
  reorderLevel       Decimal   @default(25) @db.Decimal(10, 2)
  unit               String    @default("PCS")
  lastUpdated        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  item               InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryLocation  InventoryLocation? @relation(fields: [locationId], references: [id])

  @@unique([itemId, instituteId, departmentId])
  @@index([instituteId])
  @@index([departmentId])
}

model StockTransaction {
  id                 String    @id @default(uuid())
  transactionNo      String    @unique // STX-2026-000001
  itemId             String
  instituteId        String
  departmentId       String?
  transactionType    String    // RECEIVE | ISSUE | RETURN | ADJUSTMENT
  quantity           Decimal   @db.Decimal(10, 2)
  unit               String    @default("PCS")
  unitPrice          Decimal?  @db.Decimal(10, 2)
  totalAmount        Decimal?  @db.Decimal(12, 2)
  vendorName         String?
  purchaseOrderNo    String?
  invoiceNo          String?
  issuedToUserId     String?
  issuedToName       String?
  issuedToDeptId     String?
  purpose            String?
  approvedByName     String?
  receivedByName     String?
  batchNumber        String?
  expiryDate         DateTime?
  documentUrl        String?
  remarks            String?
  transactionDate    DateTime  @default(now())
  createdAt          DateTime  @default(now())

  item               InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([instituteId])
  @@index([departmentId])
  @@index([transactionType])
  @@index([transactionDate])
}

model PhysicalFileRecord {
  id                 String    @id @default(uuid())
  fileId             String    @unique // e.g. SSIU-EXAM-2026-001, SIT-CE-NAAC-CR1-001
  fileNumber         String
  fileName           String
  fileCategory       String    // STUDENT_FILES | FACULTY_FILES | ADMISSION_FILES | EXAM_FILES | FINANCE_FILES | HR_FILES | DEPT_FILES | NAAC_IQAC_FILES | RESEARCH_FILES | EVENT_FILES | OTHER
  instituteId        String
  departmentId       String?
  locationId         String?
  academicYear       String?   // e.g. 2024-2025
  documentYear       Int?      @default(2026)
  storageLocation    String?   // e.g. Central Archive Room
  rackNumber         String?   // e.g. R-01
  shelfNumber        String?   // e.g. S-03
  boxNumber          String?   // e.g. B-12
  custodianName      String?
  custodianEmployeeId String?
  dateOpened         DateTime  @default(now())
  retentionUntil     DateTime?
  status             String    @default("ACTIVE") // ACTIVE | ARCHIVED | TRANSFERRED | DESTROYED
  description        String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inventoryLocation  InventoryLocation? @relation(fields: [locationId], references: [id])

  @@index([instituteId])
  @@index([departmentId])
  @@index([fileCategory])
  @@index([status])
  @@index([fileNumber])
}

model PhysicalVerificationLog {
  id                 String    @id @default(uuid())
  verificationNo     String    @unique // PV-2026-000001
  assetId            String
  expectedLocation   String
  actualLocation     String
  expectedCustodian  String?
  actualCustodian    String?
  physicalCondition  String    @default("GOOD") // EXCELLENT | GOOD | DAMAGED | OBSOLETE
  verifiedByUserId   String?
  verifiedByName     String
  verificationDate   DateTime  @default(now())
  status             String    @default("VERIFIED") // VERIFIED | NOT_FOUND | DAMAGED | LOCATION_MISMATCH | CUSTODIAN_MISMATCH | TRANSFER_REQUIRED
  discrepancyNotes   String?   @db.Text
  actionTaken        String?
  createdAt          DateTime  @default(now())

  asset              Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([verificationDate])
  @@index([status])
}

model InventoryAuditLog {
  id                 String    @id @default(uuid())
  action             String    // CREATE | UPDATE | ASSIGN | RETURN | ISSUE | RECEIVE | TRANSFER | MAINTENANCE | VERIFY | DISPOSE | IMPORT | EXPORT
  module             String    @default("INVENTORY") // ASSETS | CONSUMABLES | PHYSICAL_FILES | LOCATIONS | TRANSFERS
  entityId           String
  entityName         String
  instituteId        String?
  departmentId       String?
  performedByUserId  String?
  performedByName    String
  performedByRole    String?
  oldValueJson       String?   @db.Text
  newValueJson       String?   @db.Text
  remarks            String?
  timestamp          DateTime  @default(now())

  @@index([action])
  @@index([entityId])
  @@index([timestamp])
}

// --- HR, LEAVE, ATTENDANCE & PAYROLL ---

model Employee {
  id               String    @id @default(uuid())
  employeeCode     String    @unique
  erpId            String    @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String    @unique
  phone            String?
  designation      String
  employmentType   String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | ADHOC | VISITING
  employmentStatus String    @default("ACTIVE")    // ACTIVE | ON_LEAVE | TRANSFERRED | RESIGNED | RETIRED | INACTIVE
  joiningDate      DateTime  @default(now())
  instituteId      String
  departmentId     String
  userId           String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?      @relation("UserEmployee", fields: [userId], references: [id])

  serviceHistories   EmployeeServiceHistory[]
  leaveBalances      LeaveBalance[]
  leaveApplications  LeaveApplication[]
  attendances        EmployeeAttendance[]
  salaryStructures   SalaryStructure[]
  documents          EmployeeDocument[]
  dutyRequests       DutyRequest[]
  appraisals         AppraisalReview[]
  payslips           Payslip[]
  resignations       Resignation[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([employmentStatus])
}

model EmployeeServiceHistory {
  id            String   @id @default(uuid())
  employeeId    String
  changeType    String   // JOINING | TRANSFER | PROMOTION | DESIGNATION_CHANGE | DEPARTMENT_CHANGE | TRAINING | AWARD
  title         String
  description   String?
  effectiveDate DateTime @default(now())
  remarks       String?
  createdById   String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model LeaveType {
  id             String   @id @default(uuid())
  code           String   @unique // CL | SL | EL | ML | PL
  name           String
  maxDaysPerYear Int      @default(12)
  isCarryForward Boolean  @default(false)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  leaveBalances     LeaveBalance[]
  leaveApplications  LeaveApplication[]
}

model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  academicYear  String
  totalAllocated Int     @default(12)
  usedDays      Int      @default(0)
  pendingDays   Int      @default(0)
  remainingDays Int      @default(12)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, academicYear])
  @@index([employeeId])
}

model LeaveApplication {
  id                 String    @id @default(uuid())
  applicationNo      String    @unique // LEV-2026-000001
  employeeId         String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  reason             String
  status             String    @default("SUBMITTED") // SUBMITTED | VERIFIED | APPROVED | REJECTED | CANCELLED
  workflowInstanceId String?
  appliedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model EmployeeAttendance {
  id             String    @id @default(uuid())
  employeeId     String
  attendanceDate DateTime  @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         String    @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | ON_LEAVE | LATE
  remarks        String?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
}

model SalaryStructure {
  id            String   @id @default(uuid())
  employeeId    String
  basicPay      Decimal  @db.Decimal(12, 2)
  hra           Decimal  @default(0) @db.Decimal(12, 2)
  da            Decimal  @default(0) @db.Decimal(12, 2)
  specialAllow  Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  netSalary     Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// --- UNIVERSITY HOSTEL & ACCOMMODATION MANAGEMENT ---

model Hostel {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  hostelType  String   @default("STANDARD") // STANDARD | DELUXE | INTERNATIONAL
  gender      String   @default("BOYS")     // BOYS | GIRLS | CO_ED
  instituteId String?
  building    String?
  address     String?
  location    String?
  capacity    Int      @default(100)
  wardenName  String?
  wardenPhone String?
  wardenEmail String?
  status      String   @default("ACTIVE")   // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms               HostelRoom[]
  allotments          HostelAllotment[]
  attendances         HostelAttendance[]
  complaints          HostelComplaint[]
  visitors            HostelVisitor[]
  maintenances        HostelMaintenance[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@index([gender])
  @@index([status])
}

model HostelRoom {
  id           String   @id @default(uuid())
  hostelId     String
  block        String?  @default("Block A")
  roomNumber   String
  floor        Int      @default(1)
  capacity     Int      @default(2)
  occupiedBeds Int      @default(0)
  roomType     String   @default("DOUBLE") // SINGLE | DOUBLE | TRIPLE | FOUR_SEATER | OTHER | AC | NON_AC | DELUXE
  facilities   String?  // e.g. "Attached Bath, Balcony, Study Table"
  status       String   @default("AVAILABLE") // AVAILABLE | FULL | MAINTENANCE | BLOCKED
  createdAt    DateTime @default(now())

  hostel              Hostel                     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds                HostelBed[]
  allotments          HostelAllotment[]
  complaints          HostelComplaint[]
  visitors            HostelVisitor[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
  @@index([status])
}

model HostelBed {
  id         String   @id @default(uuid())
  roomId     String
  bedNumber  String   // e.g. "B1", "B2"
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE | BLOCKED
  createdAt  DateTime @default(now())

  room       HostelRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allotments HostelAllotment[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([status])
}

model HostelApplication {
  id                String    @id @default(uuid())
  applicationNo     String    @unique // HST-APP-2026-000001
  studentId         String
  academicYear      String    @default("2026-27")
  programId         String?
  semesterId        String?
  preferredHostelId String?
  roomPreference    String?   @default("NON_AC")
  reason            String?
  documents         String?
  status            String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | ELIGIBLE | WAITLISTED | APPROVED | REJECTED | ALLOTTED | CANCELLED
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model HostelAllotment {
  id               String    @id @default(uuid())
  allotmentNo      String    @unique // HST-ALL-2026-000001
  studentId        String
  hostelId         String
  roomId           String
  bedId            String
  academicYear     String    @default("2026-27")
  allottedDate     DateTime  @default(now())
  allottedByUserId String?
  checkInDate      DateTime?
  expectedCheckout DateTime?
  vacatedDate      DateTime?
  status           String    @default("ACTIVE") // ACTIVE | VACATED | TRANSFERRED | CANCELLED
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel           Hostel              @relation(fields: [hostelId], references: [id])
  room             HostelRoom          @relation(fields: [roomId], references: [id])
  bed              HostelBed           @relation(fields: [bedId], references: [id])
  transfers        HostelTransfer[]
  checkInOuts      HostelCheckInOut[]

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

model HostelTransfer {
  id            String   @id @default(uuid())
  transferNo    String   @unique // TRF-HST-2026-000001
  allotmentId   String
  fromBedId     String
  toBedId       String
  reason        String
  approvedBy    String?
  status        String   @default("COMPLETED") // PENDING | COMPLETED | REJECTED
  createdAt     DateTime @default(now())

  allotment     HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([allotmentId])
}

model HostelCheckInOut {
  id              String   @id @default(uuid())
  allotmentId     String
  actionType      String   // CHECK_IN | CHECK_OUT
  actionTime      DateTime @default(now())
  roomInspection  String?  @default("GOOD") // GOOD | REPAIR_REQUIRED | DAMAGES_NOTED
  noDuesCleared   Boolean  @default(true)
  remarks         String?

