// --- UNIVERSITY HR, EMPLOYEE, PAYROLL & RECRUITMENT ---

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  documentType String    // APPOINTMENT_LETTER | JOINING_DOC | QUALIFICATION | EXPERIENCE | ID_PROOF | PROMOTION | INCREMENT | OTHER
  title        String
  documentUrl  String
  issueDate    DateTime  @default(now())
