// ──────────────────────────────────────────────────────────────────────────────
// 41. ENTERPRISE AGENTIC ERP AUTOMATION PLATFORM (STAGE 6)
// ──────────────────────────────────────────────────────────────────────────────

model Agent {
  id           String   @id @default(uuid())
  code         String   @unique // TIMETABLE_SUBSTITUTION | SMART_DOCUMENT_VERIFIER | PROACTIVE_FEE_RECOVERY
  name         String
  description  String?
  category     String   // ACADEMICS | DMS | FINANCE | GOVERNANCE
  status       String   @default("ACTIVE") // ACTIVE | PAUSED | MAINTENANCE
  version      String   @default("1.0.0")
  tenantId     String   @default("DEFAULT")
  configJson   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executions   AgentExecution[]
  actions      AgentAction[]
  policies     AgentPolicy[]
  approvals    AgentApproval[]
  auditLogs    AgentAuditLog[]

  @@index([category])
  @@index([status])
  @@index([tenantId])
}

model AgentExecution {
  id             String   @id @default(uuid())
  agentId        String
  triggerEvent   String   // FACULTY_ABSENCE_REPORTED | DOCUMENT_UPLOADED | FEE_OVERDUE etc.
  correlationId  String
  status         String   // RUNNING | SUCCESS | FAILED | PENDING_APPROVAL | SKIPPED
  startTime      DateTime @default(now())
  endTime        DateTime?
  durationMs     Int?
  contextJson    Json?
  resultJson     Json?
  errorDetails   String?
  retryCount     Int      @default(0)
  tenantId       String   @default("DEFAULT")

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  actions        AgentAction[]
  approvals      AgentApproval[]
  auditLogs      AgentAuditLog[]

  @@index([agentId])
  @@index([triggerEvent])
  @@index([correlationId])
  @@index([status])
  @@index([tenantId])
  @@index([startTime])
}

model AgentAction {
  id             String   @id @default(uuid())
  agentId        String
  executionId    String
  actionType     String   // TOOL_CALL | POLICY_EVAL | WORKFLOW_MUTATION | NOTIFICATION
  toolName       String?
  targetResource String?
  status         String   // SUCCESS | FAILED | PENDING
  inputPayload   Json?
  outputPayload  Json?
  durationMs     Int?
  createdAt      DateTime @default(now())

  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  execution      AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([executionId])
  @@index([actionType])
  @@index([toolName])
}

model AgentPolicy {
  id               String   @id @default(uuid())
  agentId          String?
  policyCode       String   @unique // TIMETABLE_AUTO_SUBSTITUTE_THRESHOLD | DOC_AUTO_VERIFY_CONFIDENCE | FEE_MAX_EMI_INSTALLMENTS
  name             String
  description      String?
  category         String   // TIMETABLE | DMS | FINANCE
  ruleExpression   Json     // e.g. { "minConfidence": 95.0, "maxWorkloadHours": 18, "maxInstallments": 3, "minDownPaymentPct": 30.0 }
  autoApprovalFlag Boolean  @default(false)
  isActive         Boolean  @default(true)
  tenantId         String   @default("DEFAULT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([policyCode])
  @@index([category])
  @@index([tenantId])
}

model AgentApproval {
  id             String   @id @default(uuid())
  agentId        String
  executionId    String
  resourceType   String   // TIMETABLE_SUBSTITUTION | DOCUMENT_VERIFICATION | FEE_EMI_PLAN
  resourceId     String
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  decisionReason String?
  requestedData  Json
  assignedRole   String   // HOD | STUDENT_SECTION | FINANCE_OFFICER | PRINCIPAL
  assignedUserId String?
  actionTakenBy  String?
  actionTakenAt  DateTime?
  tenantId       String   @default("DEFAULT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  execution      AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([executionId])
  @@index([resourceType, resourceId])
  @@index([status])
  @@index([assignedRole])
  @@index([tenantId])
}

model AgentAuditLog {
  id             String   @id @default(uuid())
  agentId        String
  executionId    String?
  correlationId  String
  eventType      String
  actionSummary  String
  payload        Json?
  actorType      String   @default("SYSTEM_AGENT") // SYSTEM_AGENT | HUMAN_APPROVER | TRIGGER_EVENT
  actorId        String?
  tenantId       String   @default("DEFAULT")
  ipAddress      String?  @default("127.0.0.1")
  timestamp      DateTime @default(now())

  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  execution      AgentExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([executionId])
  @@index([correlationId])
  @@index([eventType])
  @@index([tenantId])
  @@index([timestamp])
}

// ──────────────────────────────────────────────────────────────────────────────
// 42. AUTONOMOUS TIMETABLE & SUBSTITUTION MODELS
// ──────────────────────────────────────────────────────────────────────────────

model TimetableScheduleEntry {
  id              String   @id @default(uuid())
  instituteId     String
  departmentId    String
  programId       String
  semesterId      String
  divisionId      String
  subjectId       String
  facultyId       String
  roomNumber      String
  dayOfWeek       String   // MONDAY | TUESDAY | WEDNESDAY | THURSDAY | FRIDAY | SATURDAY
  startTime       String   // e.g. "09:00"
  endTime         String   // e.g. "10:00"
  slotType        String   @default("THEORY") // THEORY | PRACTICAL | TUTORIAL
  status          String   @default("SCHEDULED") // SCHEDULED | SUBSTITUTED | CANCELLED | COMPLETED
  academicYear    String   @default("2026-2027")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  substitutions   SubstitutionRequest[]

  @@index([instituteId, departmentId])
  @@index([facultyId, dayOfWeek])
  @@index([divisionId, dayOfWeek])
  @@index([status])
}

model FacultyAvailability {
  id          String   @id @default(uuid())
  facultyId   String
  date        DateTime
  dayOfWeek   String
  isAvailable Boolean  @default(true)
  reason      String?  // LEAVE | ON_DUTY | WORKLOAD_EXCEEDED
  workloadMin Int      @default(0)
  maxDailyMin Int      @default(360) // 6 hours max
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([facultyId, date])
  @@index([facultyId])
  @@index([date, isAvailable])
}

model SubstitutionRequest {
  id                   String   @id @default(uuid())
  timetableEntryId     String
  originalFacultyId    String
  substituteFacultyId  String?
  absenceDate          DateTime
  status               String   @default("PROPOSED") // PROPOSED | AUTO_APPROVED | HOD_APPROVED | REJECTED | CANCELLED
  matchingScore        Float    @default(0.0) // 0.0 to 100.0
  reasonForAbsence     String?
  approvalMode         String   @default("MANUAL") // AUTO | MANUAL
  approvedByUserId     String?
  approvedAt           DateTime?
  tenantId             String   @default("DEFAULT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  timetableEntry       TimetableScheduleEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)

  @@index([timetableEntryId])
  @@index([originalFacultyId])
  @@index([substituteFacultyId])
  @@index([absenceDate])
  @@index([status])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 43. SMART DOCUMENT VERIFIER MODELS
// ──────────────────────────────────────────────────────────────────────────────

model DocumentExtraction {
  id                 String   @id @default(uuid())
  documentId         String   @unique
  studentId          String
  documentType       String   // LEAVING_CERTIFICATE | BONAFIDE | MARKSHEET | PHOTO_ID | INCOME_CERT
  ocrTextRaw         String?
  extractedFields    Json     // { "name": "...", "enrollmentNo": "...", "dob": "...", "institute": "..." }
  ocrConfidence      Float    // 0.0 to 100.0
  createdAt          DateTime @default(now())

  verificationResult DocumentVerificationResult?

  @@index([studentId])
  @@index([documentType])
}

model DocumentVerificationResult {
  id                   String   @id @default(uuid())
  extractionId         String   @unique
  documentId           String   @unique
  studentId            String
  overallScore         Float    // 0.0 to 100.0
  decision             String   // AUTO_VERIFIED | ADMIN_REVIEW | REJECTED
  matchingDetails      Json     // { "nameMatch": true, "enrollmentMatch": true, "dobMatch": true }
  discrepancies        Json?    // list of mismatched fields
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewRemarks        String?
  tenantId             String   @default("DEFAULT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  extraction           DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([decision])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 44. PROACTIVE FEE RECOVERY & CONVERSATIONAL EMI MODELS
// ──────────────────────────────────────────────────────────────────────────────

model FeeRecoveryCase {
  id                  String   @id @default(uuid())
  studentId           String
  totalDueAmount      Float
  currentOverdue      Float
  dueSinceDate        DateTime
  status              String   @default("OPEN") // OPEN | ENGAGED | PROPOSED_EMI | RESOLVED | ESCALATED
  riskLevel           String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  lastContactedAt     DateTime?
  tenantId            String   @default("DEFAULT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversations       FeeConversation[]
  proposals           FeeNegotiationProposal[]
  emiPlans            FeeEMIPlan[]

  @@index([studentId])
  @@index([status])
  @@index([riskLevel])
  @@index([tenantId])
}

model FeeConversation {
  id             String   @id @default(uuid())
  caseId         String
  channel        String   // IN_APP | EMAIL | WHATSAPP | SMS
  direction      String   // OUTBOUND | INBOUND
  senderType     String   // AI_AGENT | STUDENT | FINANCE_OFFICER
  messageText    String
  intentDetected String?  // PROMISE_TO_PAY | REQUEST_EMI | FINANCIAL_HARDSHIP | DISPUTE
  payload        Json?
  timestamp      DateTime @default(now())

  recoveryCase   FeeRecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([channel])
  @@index([intentDetected])
}

model FeeNegotiationProposal {
  id                 String   @id @default(uuid())
  caseId             String
  proposedBy         String   @default("AI_AGENT") // AI_AGENT | STUDENT | OFFICER
  totalAmount        Float
  downPaymentAmount  Float
  downPaymentDueDate DateTime
  installmentsCount  Int      @default(2)
  installmentTerms   Json     // [ { "seq": 1, "amount": 25000, "dueDate": "2026-09-30" }, ... ]
  status             String   @default("PROPOSED") // PROPOSED | ACCEPTED | REJECTED | CANCELLED
  policyCheckPassed  Boolean  @default(true)
  validationErrors   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recoveryCase       FeeRecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  emiPlan            FeeEMIPlan?

  @@index([caseId])
  @@index([status])
}

model FeeEMIPlan {
  id              String   @id @default(uuid())
  caseId          String
  proposalId      String?  @unique
  studentId       String
  totalPlanAmount Float
  totalPaidAmount Float    @default(0.0)
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED | CANCELLED
  approvedByRole  String   @default("POLICY_ENGINE") // POLICY_ENGINE | FINANCE_OFFICER
  approvedByUserId String?
  tenantId        String   @default("DEFAULT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recoveryCase    FeeRecoveryCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposal        FeeNegotiationProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  installments    FeeEMIInstallment[]

  @@index([caseId])
  @@index([studentId])
  @@index([status])
  @@index([tenantId])
}

model FeeEMIInstallment {
  id              String    @id @default(uuid())
  planId          String
  installmentNo   Int
  dueDate         DateTime
  amount          Float
  paidAmount      Float     @default(0.0)
  status          String    @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  paidDate        DateTime?
  transactionRef  String?
  paymentLinkUrl  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  plan            FeeEMIPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([dueDate])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────────
// 45. MULTI-CHANNEL COMMUNICATION & EVENT AUTOMATION
// ──────────────────────────────────────────────────────────────────────────────

model CommunicationLog {
  id             String   @id @default(uuid())
  recipientType  String   // STUDENT | FACULTY | PARENT | ADMIN
  recipientId    String
  channel        String   // IN_APP | EMAIL | WHATSAPP | PUSH
  direction      String   @default("OUTBOUND")
  templateCode   String?
  subject        String?
  messageBody    String
  providerId     String?
  deliveryStatus String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED
  failureReason  String?
  retryCount     Int      @default(0)
  tenantId       String   @default("DEFAULT")
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries     NotificationDelivery[]

  @@index([recipientId, channel])
  @@index([deliveryStatus])
  @@index([tenantId])
  @@index([createdAt])
}

model NotificationDelivery {
  id                String   @id @default(uuid())
  communicationLogId String
  channel           String
  externalMessageId String?
  status            String   // DELIVERED | READ | BOUNCED | REJECTED
  statusTimestamp   DateTime @default(now())
  rawResponse       Json?

  log               CommunicationLog @relation(fields: [communicationLogId], references: [id], onDelete: Cascade)

  @@index([communicationLogId])
  @@index([status])
}

model AutomationEvent {
  id            String   @id @default(uuid())
  eventType     String   // FACULTY_ABSENCE_REPORTED | DOCUMENT_UPLOADED | FEE_OVERDUE etc.
  eventSource   String   // TIMETABLE_MODULE | DMS_MODULE | FEE_MODULE | USER_ACTION
  idempotencyKey String  @unique
  payload       Json
  status        String   @default("PENDING") // PENDING | PROCESSED | FAILED | DUPLICATE
  processedAt   DateTime?
  errorDetails  String?
  tenantId      String   @default("DEFAULT")
  createdAt     DateTime @default(now())

  jobs          AutomationJob[]

  @@index([eventType])
  @@index([status])
  @@index([tenantId])
  @@index([createdAt])
}

model AutomationJob {
  id             String   @id @default(uuid())
  eventId        String
  agentCode      String
  status         String   @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | RETRYING
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  nextRunAt      DateTime @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  resultSummary  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([agentCode])
  @@index([status, nextRunAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// NATIONAL UMS & UGC / NEP 2020 COMPLIANCE MODULES
// ──────────────────────────────────────────────────────────────────────────────

// 1. Govt & NEP Compliance Module
model AcademicBankOfCredit {
  id                 String    @id @default(uuid())
  abcId              String    @unique
  totalCredits       Int       @default(0)
  studentId          String    @unique
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  verificationStatus String    @default("PENDING_VERIFICATION") // NOT_SUBMITTED | PENDING_VERIFICATION | VERIFIED | REJECTED
  verifiedAt         DateTime?
  verifiedByUserId   String?
  lastSyncAt         DateTime?
  syncStatus         String    @default("NOT_SYNCED") // NOT_SYNCED | PENDING | SYNCED | FAILED
  syncError          String?
  tenantId           String    @default("DEFAULT")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creditEntries      AcademicCreditLedger[]
  syncRecords        AbcSyncRecord[]

  @@index([studentId])
  @@index([syncStatus])
  @@index([verificationStatus])
  @@index([tenantId])
}

model AcademicCreditLedger {
  id              String   @id @default(uuid())
  abcProfileId    String?
  studentId       String
  semesterId      String?
  semesterNumber  Int      @default(1)
  courseId        String?
  courseCode      String
  courseName      String
  creditValue     Decimal  @db.Decimal(5, 2)
  creditType      String   @default("CORE") // CORE | ELECTIVE | MOOC | TRANSFER | VALUE_ADDED
  academicYear    String   @default("2026-27")
  status          String   @default("EARNED") // EARNED | IN_PROGRESS | TRANSFERRED | FAILED
  earnedAt        DateTime?
  sourceReference String?  // e.g. "SSIU Exam 2026-S1", "SWAYAM-CS101"
  tenantId        String   @default("DEFAULT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abcProfile      AcademicBankOfCredit? @relation(fields: [abcProfileId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseCode, academicYear])
  @@index([studentId])
  @@index([abcProfileId])
  @@index([semesterId])
  @@index([status])
  @@index([tenantId])
}

model AbcSyncRecord {
  id            String   @id @default(uuid())
  abcProfileId  String?
  studentId     String
  abcId         String
  operation     String   // LINK | VERIFY | SYNC_CREDITS | RETRY
  status        String   // PENDING | SUCCESS | FAILED | NOT_CONFIGURED
  attempts      Int      @default(1)
  lastAttemptAt DateTime @default(now())
  error         String?
  correlationId String
  tenantId      String   @default("DEFAULT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  abcProfile    AcademicBankOfCredit? @relation(fields: [abcProfileId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([abcProfileId])
  @@index([abcId])
  @@index([status])
  @@index([tenantId])
}

// 2. Outcome-Based Education (OBE) Module
model CourseOutcome {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  courseId           String?
  subjectId          String?
  code               String   // e.g. "CO1", "CO2"
  description        String
  academicYear       String   @default("2025-26")
  version            String   @default("v1.0")
  status             String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  copoMappings       COPOMapping[]
  psoMappings        COPSOMapping[]
  assessmentMaps     AssessmentCOMap[]
  studentAttainments StudentCOAttainment[]
  courseAttainments  CourseAttainment[]
  improvementActions OBEImprovementAction[]

  @@index([courseId])
  @@index([subjectId])
  @@index([code])
  @@index([status])
  @@index([tenantId])
}

model ProgramOutcome {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  programId          String?
  code               String   // e.g. "PO1", "PO2"
  description        String
  version            String   @default("v1.0")
  status             String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  copoMappings       COPOMapping[]
  programAttainments ProgramAttainment[]

  @@index([programId])
  @@index([code])
  @@index([status])
  @@index([tenantId])
}

model COPOMapping {
  id               String         @id @default(uuid())
  tenantId         String         @default("DEFAULT")
  coId             String
  poId             String
  correlationLevel Int            @default(3) // Correlation Level: 0 (None), 1 (Low), 2 (Medium), 3 (High)
  weight           Float          @default(1.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  courseOutcome    CourseOutcome  @relation(fields: [coId], references: [id], onDelete: Cascade)
  programOutcome   ProgramOutcome @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@unique([coId, poId])
  @@index([coId])
  @@index([poId])
  @@index([tenantId])
}

// 3. UGC Grievance System
model GrievanceTicket {
  id              String   @id @default(uuid())
  category        String   // e.g., Ragging, Harassment, Infrastructure, Academic, Administrative
  description     String
  isAnonymous     Boolean  @default(false)
  status          String   @default("Pending") // Pending, InProgress, Resolved
  escalationLevel Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
}

// 4. Startup & Grants Module
model StartupResearchGrant {
  id              String   @id @default(uuid())
  title           String
  grantType       String   // e.g., SSIP, DST, AICTE, GUJCOST, SERB
  amountAllocated Float    @default(0.0)
  amountSpent     Float    @default(0.0)
  facultyId       String
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, SANCTIONED, CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facultyId])
  @@index([grantType])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────────
// DIGILOCKER NATIONAL REPOSITORY & CITIZEN ACADEMIC DOCUMENT INTEGRATION
// ──────────────────────────────────────────────────────────────────────────────

model DigiLockerConnection {
  id                    String    @id @default(uuid())
  tenantId              String    @default("DEFAULT")
  studentId             String    @unique
  status                String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | DISCONNECTED | ERROR
  provider              String    @default("DIGILOCKER_NAD")
  externalUserReference String?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  documents             DigiLockerDocument[]
  syncLogs              DigiLockerSyncLog[]

  @@index([studentId])
  @@index([status])
  @@index([tenantId])
}

model DigiLockerDocument {
  id                        String    @id @default(uuid())
  tenantId                  String    @default("DEFAULT")
  studentId                 String
  documentId                String?
  documentType              String    // DEGREE | MARKSHEET | TRANSCRIPT | PROVISIONAL | MIGRATION
  documentNumber            String
  issuer                    String    @default("SSIU_UNIVERSITY")
  status                    String    @default("PENDING") // PENDING | SUBMITTED | PROCESSING | ISSUED | FAILED | RETRY_REQUIRED | CANCELLED
  externalDocumentReference String?
  issuedAt                  DateTime?
  publishedAt               DateTime?
  lastSyncedAt              DateTime?
  connectionId              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  connection                DigiLockerConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, documentType, documentNumber])
  @@index([studentId])
  @@index([documentType])
  @@index([status])
  @@index([connectionId])
  @@index([tenantId])
}

model DigiLockerSyncLog {
  id            String   @id @default(uuid())
  tenantId      String   @default("DEFAULT")
  studentId     String
  connectionId  String?
  operation     String   // CONNECT | SYNC | ISSUE_DOCUMENT | DISCONNECT | RETRY
  status        String   // PENDING | SUCCESS | FAILED | NOT_CONFIGURED
  attempt       Int      @default(1)
  correlationId String
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime @default(now())

  connection    DigiLockerConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([connectionId])
  @@index([status])
  @@index([correlationId])
  @@index([tenantId])
}

model DigiLockerConsent {
  id             String    @id @default(uuid())
  tenantId       String    @default("DEFAULT")
  studentId      String    @unique
  consentVersion String    @default("v1.0")
  consentGiven   Boolean   @default(false)
  consentAt      DateTime?
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([studentId])
  @@index([consentGiven])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────────
// NAAC + NBA ACCREDITATION MANAGEMENT & REPORT GENERATOR
// ──────────────────────────────────────────────────────────────────────────────

model AccreditationFramework {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  name               String   // NAAC | NBA
  version            String   @default("v2026.1")
  status             String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  academicYearRange  String   @default("2021-22 to 2025-26")
  configuration      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  criteria           AccreditationCriterion[]

  @@index([name])
  @@index([status])
  @@index([tenantId])
}

model AccreditationCriterion {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  frameworkId        String
  criterionNumber    Int
  code               String   // e.g. "CR1", "CR2"
  title              String
  description        String?
  weightage          Float    @default(100.0)
  configuration      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  framework          AccreditationFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  metrics            AccreditationMetric[]

  @@index([frameworkId])
  @@index([criterionNumber])
  @@index([tenantId])
}

model AccreditationMetric {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  criterionId        String
  code               String   // e.g. "1.1.1", "2.2.1"
  name               String
  description        String?
  formula            String?
  unit               String   @default("COUNT") // COUNT | PERCENTAGE | RATIO | INR_LAKHS | SCORE
  sourceModule       String   // STUDENTS | EXAMINATIONS | FACULTY | RESEARCH | PLACEMENTS | INFRASTRUCTURE
  sourceEntity       String?
  calculationMethod  String   @default("COUNT") // COUNT | SUM | AVERAGE | PERCENTAGE | RATIO | DISTINCT_COUNT | YEAR_OVER_YEAR_CHANGE
  configuration      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  criterion          AccreditationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  aggregatedValues   AccreditationAggregatedValue[]
  evidences          AccreditationEvidence[]

  @@index([criterionId])
  @@index([code])
  @@index([sourceModule])
  @@index([tenantId])
}

model AccreditationAggregatedValue {
  id                    String   @id @default(uuid())
  tenantId              String   @default("DEFAULT")
  metricId              String
  academicYear          String   // e.g. "2024-25"
  scopeType             String   @default("INSTITUTION") // INSTITUTION | DEPARTMENT | PROGRAM
  scopeId               String   @default("ALL") // "ALL" or departmentId or programId
  departmentId          String?
  programId             String?
  value                 Float?
  status                String   @default("VALID") // VALID | WARNING | MISSING | NOT_AVAILABLE
  sourceRecordCount     Int      @default(0)
  sourceRecordReference String?
  details               Json?
  generatedAt           DateTime @default(now())

  metric                AccreditationMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  department            Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program               Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([metricId, academicYear, tenantId, scopeType, scopeId])
  @@index([metricId])
  @@index([academicYear])
  @@index([scopeType])
  @@index([scopeId])
  @@index([departmentId])
  @@index([programId])
  @@index([status])
  @@index([tenantId])
}

