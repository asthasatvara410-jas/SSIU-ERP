// --- RESEARCH, INNOVATION & INCUBATION ---

model ResearchProject {
  id             String    @id @default(uuid())
  projectCode    String    @unique // PRJ-2026-000001
  title          String
  abstract       String?
  projectType    String    @default("INTERNAL") // INTERNAL | SPONSORED | CONSULTANCY | COLLABORATIVE
  researchArea   String?
  piFacultyId    String
  departmentId   String
  instituteId    String
  startDate      DateTime
  endDate        DateTime?
  totalBudget    Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("SUBMITTED") // SUBMITTED | APPROVED | IN_PROGRESS | COMPLETED | REJECTED
  createdByUserId String
  createdAt      DateTime  @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  institute  Institute  @relation(fields: [instituteId], references: [id])
  createdByUser User    @relation("ResearchCreatedBy", fields: [createdByUserId], references: [id])

  members      ResearchMember[]
  milestones   ResearchMilestone[]
  grants       ResearchGrant[]
  publications Publication[]
  patents      Patent[]
  authorRecords ResearchAuthor[]
  evidences    ResearchEvidence[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([status])
}

model ResearchMember {
  id        String   @id @default(uuid())
  projectId String
  facultyId String
  role      String   @default("CO_INVESTIGATOR") // PI | CO_INVESTIGATOR | RESEARCH_SCHOLAR | CONSULTANT
  joinedAt  DateTime @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  faculty Faculty         @relation(fields: [facultyId], references: [id])

  @@index([projectId])
  @@index([facultyId])
}

model ResearchMilestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING | COMPLETED | DELAYED
  deliverable String?

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ResearchGrant {
  id            String   @id @default(uuid())
  grantNo       String   @unique // GRT-2026-000001
  projectId     String
  fundingAgency String
  proposedAmount Decimal  @db.Decimal(12, 2)
  approvedAmount Decimal  @default(0) @db.Decimal(12, 2)
  releasedAmount Decimal  @default(0) @db.Decimal(12, 2)
  utilizedAmount Decimal  @default(0) @db.Decimal(12, 2)
  status        String   @default("PROPOSED") // PROPOSED | APPROVED | RELEASED | UTILIZED | COMPLETED
  createdAt     DateTime @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Publication {
  id                  String                    @id @default(uuid())
  tenantId            String                    @default("DEFAULT")
  projectId           String?
  title               String
  abstract            String?
  authors             String
  journalName         String?
  publicationType     String                    @default("JOURNAL") // JOURNAL | CONFERENCE | BOOK_CHAPTER | PATENT_PAPER
  publicationDate     DateTime?
  journalId           String?
  conferenceId        String?
  publisher           String?
  volume              String?
  issue               String?
  pages               String?
  year                Int                       @default(2026)
  doi                 String?
  issn                String?
  isbn                String?
  url                 String?
  indexing            String?                   // SCOPUS | SCI | WOS | UGC_CARE
  documentUrl         String?
  citationCount       Int                       @default(0)
  citationSource      String                    @default("UNKNOWN")
  citationRetrievedAt DateTime?
  validationStatus    String                    @default("NOT_VERIFIED") // NOT_VERIFIED, VERIFIED, NOT_FOUND, ERROR, PARTIAL_MATCH
  approvalStatus      String                    @default("APPROVED") // DRAFT, SUBMITTED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED
  duplicateStatus     String                    @default("UNIQUE") // UNIQUE, POSSIBLE_DUPLICATE, DUPLICATE_CONFIRMED
  status              String                    @default("PUBLISHED")
  createdBy           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime?                 @updatedAt

  project             ResearchProject?          @relation(fields: [projectId], references: [id])
  journal             Journal?                  @relation(fields: [journalId], references: [id])
  conference          Conference?               @relation(fields: [conferenceId], references: [id])
  authorRecords       ResearchAuthor[]
  evidences           ResearchEvidence[]
  validationResults   ResearchValidationResult[]
  approvalActions     ResearchApprovalAction[]

  @@index([projectId])
  @@index([title])
  @@index([doi])
  @@index([publicationType])
  @@index([validationStatus])
  @@index([approvalStatus])
  @@index([tenantId])
}

model Patent {
  id                String                   @id @default(uuid())
  tenantId          String                   @default("DEFAULT")
  projectId         String?
  title             String
  inventors         String
  applicationNumber String                   @unique
  publicationNumber String?
  patentNumber      String?
  filingDate        DateTime
  publicationDate   DateTime?
  grantDate         DateTime?
  jurisdiction      String                   @default("INDIA (IPO)")
  applicant         String                   @default("Swarrnim Startup & Innovation University")
  assignee          String?
  url               String?
  validationStatus  String                   @default("NOT_VERIFIED") // NOT_VERIFIED, VERIFIED, NOT_FOUND, ERROR
  approvalStatus    String                   @default("APPROVED") // DRAFT, SUBMITTED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED
  status            String                   @default("FILED") // FILED | UNDER_EXAMINATION | GRANTED | REJECTED
  createdBy         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime?                @updatedAt

  project           ResearchProject?         @relation(fields: [projectId], references: [id])
  inventorRecords   PatentInventor[]
  authorRecords     ResearchAuthor[]
  evidences         ResearchEvidence[]
  approvalActions   ResearchApprovalAction[]

  @@index([projectId])
  @@index([title])
  @@index([applicationNumber])
  @@index([patentNumber])
  @@index([status])
  @@index([validationStatus])
  @@index([approvalStatus])
  @@index([tenantId])
}

model InnovationIdea {
  id               String   @id @default(uuid())
  ideaCode         String   @unique // IDN-2026-000001
  creatorUserId    String
  category         String
  problemStatement String
  solution         String
  status           String   @default("IDEA") // IDEA | SUBMITTED | UNDER_REVIEW | SHORTLISTED | MENTORING | PROTOTYPE | PILOT | COMPLETED | REJECTED
  evaluationNotes  String?
  createdAt        DateTime @default(now())

  creatorUser User @relation("InnovationCreator", fields: [creatorUserId], references: [id])

  @@index([creatorUserId])
  @@index([status])
}

model IncubationCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  location    String?
  capacity    Int      @default(20)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  startups Startup[]
}

model Startup {
  id                 String    @id @default(uuid())
