// --- UNIVERSITY COMMUNICATION & OFFICIAL CORRESPONDENCE ---

model CommunicationType {
  id          String   @id @default(uuid())
  code        String   @unique // LETTER | CIRCULAR | NOTICE | OFFICE_ORDER | MEMO | INVITATION | APPOINTMENT | PERMISSION | APPROVAL | WARNING | CERTIFICATE | REPLY | REQUEST | INTERNAL
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  communications Communication[]
}

model Communication {
  id                String    @id @default(uuid())
  referenceNo       String    @unique // COMM-2026-000001
  inwardNo          String?   // INW-2026-000001
  outwardNo         String?   // OUT-2026-000001
  direction         String    @default("INTERNAL") // INWARD | OUTWARD | INTERNAL
  communicationTypeId String
  subject           String
  content           String?
  priority          String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status            String    @default("RECEIVED") // DRAFT | RECEIVED | UNDER_REVIEW | APPROVAL_PENDING | APPROVED | REJECTED | ASSIGNED | IN_PROCESS | FORWARDED | REPLIED | SENT | CLOSED | ARCHIVED
  
  // Sender Details
  senderName        String?
  senderOrganization String?
  senderEmail       String?
  receivedThrough   String?   // EMAIL | POST | COURIER | HAND_DELIVERY | WEBSITE | OTHER
  receivedDate      DateTime? @db.Date

  // Department & Institute Scoping
  instituteId       String?
  departmentId      String?
  creatorUserId     String
  assignedUserId    String?
  dueDate           DateTime? @db.Date
  
  // Digital Signature Foundation
  signatureStatus   String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | PENDING | SIGNED | VERIFIED
  signedByUserId    String?
  signedDate        DateTime?

  documentUrl       String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  communicationType CommunicationType @relation(fields: [communicationTypeId], references: [id])
  creator           User              @relation("CommCreator", fields: [creatorUserId], references: [id])

  recipients        CommunicationRecipient[]
  assignments       CommunicationAssignment[]
  movements         CommunicationMovement[]
  approvals         CommunicationApproval[]
  dispatchRecords   DispatchRecord[]

  @@index([referenceNo])
  @@index([direction])
  @@index([status])
  @@index([creatorUserId])
  @@index([assignedUserId])
  @@index([departmentId])
}

model CommunicationRecipient {
  id              String   @id @default(uuid())
  communicationId String
  recipientType   String   @default("TO") // TO | CC | BCC
  recipientUserId String?
  recipientEmail  String?
  recipientName   String?
  isRead          Boolean  @default(false)
  readAt          DateTime?

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationAssignment {
  id              String   @id @default(uuid())
  communicationId String
  assignedByUserId String
  assignedToUserId String
  departmentId    String?
  instruction     String?
  dueDate         DateTime? @db.Date
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  assignedAt      DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationMovement {
  id              String   @id @default(uuid())
  communicationId String
  movedByUserId   String
  fromOffice      String
  toOffice        String
  actionTaken     String   // CREATED | REGISTERED | FORWARDED | REJECTED | RETURNED | APPROVED | CLOSED
  remarks         String?
  movedAt         DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationApproval {
  id              String   @id @default(uuid())
  communicationId String
  approverUserId  String
  stepNumber      Int      @default(1)
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | RETURNED
  comments        String?
  actedAt         DateTime?
  createdAt       DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model DispatchRecord {
  id              String    @id @default(uuid())
  communicationId String
  dispatchNo      String    @unique // DSP-2026-000001
  dispatchDate    DateTime  @default(now())
  recipientName   String
  recipientAddress String?
  dispatchMethod  String    @default("COURIER") // POST | COURIER | HAND_DELIVERY | EMAIL | OTHER
  trackingNo      String?
  courierAgency   String?
  deliveryStatus  String    @default("PREPARED") // PREPARED | DISPATCHED | IN_TRANSIT | DELIVERED | RETURNED
  deliveredDate   DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([dispatchNo])
  @@index([deliveryStatus])
}

// --- UNIVERSITY INWARD & OUTWARD REGISTER ---

model InwardRegister {
  id               String    @id @default(uuid())
  registerNo       String    @unique // INW/2026/000001
  receiptDate      DateTime  @default(now()) @db.Date
  receivedDate     DateTime  @default(now()) @db.Date
  senderName       String
  senderOrganization String?
  senderEmail      String?
  senderPhone      String?
  letterNumber     String?
  letterDate       DateTime? @db.Date
  subject          String
  description      String?
  documentType     String    @default("LETTER") // LETTER | CIRCULAR | NOTICE | APPLICATION | GOVERNMENT_COMMUNICATION | UNIVERSITY_COMMUNICATION | INVOICE | LEGAL_DOCUMENT | ACADEMIC_DOCUMENT | OTHER
  departmentId     String?
  receivedByUserId String
  assignedToUserId String?
  priority         String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  receivedThrough  String    @default("POST") // POST | COURIER | EMAIL | HAND_DELIVERY | OTHER
  status           String    @default("RECEIVED") // RECEIVED | UNDER_PROCESS | FORWARDED | ACTION_REQUIRED | COMPLETED | CLOSED
  dueDate          DateTime? @db.Date
  documentUrl      String?
  attachmentName   String?
  documentSize     Int?
  documentTypeMime String?
  remarks          String?
  notesheetId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  department       Department?           @relation(fields: [departmentId], references: [id])
  receivedBy       User                  @relation("InwardReceiver", fields: [receivedByUserId], references: [id])
  assignedTo       User?                 @relation("InwardAssignee", fields: [assignedToUserId], references: [id])
  forwardings      InwardForwarding[]
  statusHistory    InwardStatusHistory[]
  auditLogs        InwardOutwardAuditLog[]

  @@index([registerNo])
  @@index([receivedDate])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([receivedByUserId])
  @@index([assignedToUserId])
  @@index([notesheetId])
}

model InwardForwarding {
  id                     String    @id @default(uuid())
  inwardId               String
  forwardedByUserId      String
  forwardedToOffice      String?
  forwardedToDepartmentId String?
  forwardedToUserId      String?
  forwardedDate          DateTime  @default(now())
  actionRequired         String
  dueDate                DateTime? @db.Date
  remarks                String?
  status                 String    @default("PENDING") // PENDING | IN_PROGRESS | ACTION_TAKEN | COMPLETED
  actionTaken            String?
  actionTakenDate        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  inward                 InwardRegister @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  forwardedBy            User           @relation("InwardForwarder", fields: [forwardedByUserId], references: [id])

  @@index([inwardId])
  @@index([forwardedByUserId])
  @@index([forwardedToDepartmentId])
  @@index([forwardedToUserId])
  @@index([status])
}

model InwardStatusHistory {
  id                String   @id @default(uuid())
  inwardId          String
  fromStatus        String?
  toStatus          String
  changedByUserId   String
  remarks           String?
  createdAt         DateTime @default(now())

  inward            InwardRegister @relation(fields: [inwardId], references: [id], onDelete: Cascade)

  @@index([inwardId])
  @@index([changedByUserId])
}

model OutwardRegister {
  id                   String    @id @default(uuid())
  dispatchNo           String    @unique // OUT/2026/000001
  dispatchDate         DateTime  @default(now()) @db.Date
  letterDate           DateTime? @db.Date
  receiverName         String
  receiverOrganization String?
  receiverAddress      String?
  receiverEmail        String?
  receiverPhone        String?
  subject              String
  referenceNumber      String?
  documentType         String    @default("LETTER") // LETTER | CIRCULAR | NOTICE | APPLICATION | GOVERNMENT_COMMUNICATION | UNIVERSITY_COMMUNICATION | INVOICE | LEGAL_DOCUMENT | ACADEMIC_DOCUMENT | OTHER
  departmentId         String?
  sentByUserId         String
  mode                 String    @default("COURIER") // POST | COURIER | EMAIL | HAND_DELIVERY | OTHER
  courierService       String?
  trackingNo           String?
  priority             String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status               String    @default("DRAFT") // DRAFT | READY | DISPATCHED | DELIVERED | RETURNED | CANCELLED
  expectedDeliveryDate DateTime? @db.Date
  deliveredDate        DateTime? @db.Date
  deliveryStatus       String?   // PENDING | IN_TRANSIT | DELIVERED | RETURNED | LOST
  documentUrl          String?
  attachmentName       String?
  remarks              String?
  notesheetId          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  department           Department?            @relation(fields: [departmentId], references: [id])
  sentBy               User                   @relation("OutwardSender", fields: [sentByUserId], references: [id])
  dispatches           OutwardDispatch[]
  statusHistory        OutwardStatusHistory[]
  auditLogs            InwardOutwardAuditLog[]

  @@index([dispatchNo])
  @@index([dispatchDate])
  @@index([departmentId])
  @@index([status])
  @@index([mode])
  @@index([sentByUserId])
  @@index([notesheetId])
}

model OutwardDispatch {
  id                   String    @id @default(uuid())
  outwardId            String
  courierService       String
  trackingNumber       String?
  dispatchDate         DateTime  @default(now())
  expectedDeliveryDate DateTime? @db.Date
  deliveryDate         DateTime? @db.Date
  deliveryStatus       String    @default("PENDING") // PENDING | IN_TRANSIT | DELIVERED | RETURNED | LOST
  dispatchedByUserId   String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  outward              OutwardRegister @relation(fields: [outwardId], references: [id], onDelete: Cascade)

  @@index([outwardId])
  @@index([deliveryStatus])
}

model OutwardStatusHistory {
  id                String   @id @default(uuid())
  outwardId         String
  fromStatus        String?
  toStatus          String
  changedByUserId   String
  remarks           String?
  createdAt         DateTime @default(now())

  outward           OutwardRegister @relation(fields: [outwardId], references: [id], onDelete: Cascade)

  @@index([outwardId])
  @@index([changedByUserId])
}

model InwardOutwardAuditLog {
  id                String   @id @default(uuid())
  recordType        String   // INWARD | OUTWARD
  inwardId          String?
  outwardId         String?
  action            String   // CREATED | UPDATED | STATUS_CHANGED | ASSIGNED | FORWARDED | ACTION_TAKEN | ATTACHMENT_ADDED | DISPATCHED | DELIVERED | RETURNED | COMPLETED | CLOSED | CANCELLED
  performedByUserId String
  fromStatus        String?
  toStatus          String?
  remarks           String?
  createdAt         DateTime @default(now())

  inward            InwardRegister?  @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  outward           OutwardRegister? @relation(fields: [outwardId], references: [id], onDelete: Cascade)
  performedBy       User             @relation("RegisterAuditActor", fields: [performedByUserId], references: [id])

  @@index([recordType])
  @@index([inwardId])
  @@index([outwardId])
  @@index([performedByUserId])
}

// --- DIGITAL STUDENT SERVICE DESK & CERTIFICATES ---

model StudentService {
  id                  String   @id @default(uuid())
  code                String   @unique // BONAFIDE | CHARACTER_CERT | TRANSCRIPT | MIGRATION | TRANSFER_CERT | ID_CARD | DUPLICATE_ID | FEE_RECEIPT | NO_DUES | EXAM_REQ | RESULT_REQ | INTERNSHIP_LETTER | PERMISSION_LETTER | SCHOLARSHIP_REQ | HOSTEL_REQ | TRANSPORT_REQ | LIBRARY_REQ | GENERAL_REQ
  name                String
  description         String?
  category            String   @default("CERTIFICATE") // CERTIFICATE | ACADEMIC | ADMINISTRATIVE | FINANCE | HOSTEL | TRANSPORT | EXAMINATION | OTHER
  expectedDays        Int      @default(3)
  feeAmount           Decimal  @default(0) @db.Decimal(10, 2)
  responsibleRoleCode String   @default("STUDENT_SECTION") // STUDENT_SECTION | HOD | HOI | REGISTRAR | EXAM_SECTION | FINANCE_OFFICER
  responsibleDept     String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requirements StudentServiceRequirement[]
  requests     StudentServiceRequest[]
  certificates Certificate[]

  @@index([category])
  @@index([isActive])
}

model StudentServiceRequirement {
  id               String   @id @default(uuid())
  serviceId        String
  documentName     String
  isRequired       Boolean  @default(true)
  allowedFileTypes String   @default("PDF,JPG,PNG")
  maxSizeBytes     Int      @default(5242880) // 5MB
  instructions     String?
  createdAt        DateTime @default(now())

  service StudentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model StudentServiceRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique // REQ-2026-000001
  studentId            String
  serviceId            String
  departmentId         String?
  subject              String?
  description          String?
  category             String?   // ACADEMIC | CERTIFICATE | HOSTEL | TRANSPORT | FINANCE | LIBRARY | EXAMINATION | GENERAL | OTHER
  priority             String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  submissionDate       DateTime  @default(now())
  status               String    @default("SUBMITTED") // SUBMITTED | ASSIGNED | IN_PROGRESS | PENDING_STUDENT | RESOLVED | REJECTED | CANCELLED | COMPLETED
  currentStage         String    @default("SUBMITTED")
  currentAuthorityRole String    @default("STUDENT_SECTION")
  assignedToUserId     String?
  assignedDepartmentId String?
  purpose              String?
  remarks              String?
  resolution           String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  rejectionReason      String?
  dueDate              DateTime? @db.Date
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student              Student                         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service              StudentService                  @relation(fields: [serviceId], references: [id])
  department           Department?                     @relation(fields: [departmentId], references: [id])

  documents            StudentServiceRequestDocument[]
  certificates         Certificate[]
  messages             StudentServiceRequestMessage[]
  history              StudentServiceRequestHistory[]

  @@index([requestNo])
  @@index([studentId])
  @@index([serviceId])
  @@index([departmentId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([priority])
  @@index([currentAuthorityRole])
}

model StudentServiceRequestDocument {
  id          String   @id @default(uuid())
  requestId   String
  name        String
  documentUrl String
  fileSize    Int?
  fileType    String?
  uploadedAt  DateTime @default(now())

  request     StudentServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model StudentServiceRequestMessage {
  id          String   @id @default(uuid())
  requestId   String
  senderId    String
  senderName  String?
  senderType  String   // STUDENT | STAFF | ADMIN | SYSTEM
  message     String
  attachments String?  // JSON string or comma-separated URLs
  isInternal  Boolean  @default(false) // Staff internal note
  createdAt   DateTime @default(now())

  request     StudentServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([senderId])
}

model StudentServiceRequestHistory {
  id                String   @id @default(uuid())
  requestId         String
  action            String   // CREATED | ASSIGNED | STATUS_CHANGED | REPLIED | RESOLVED | REJECTED | CANCELLED | REOPENED
  performedByUserId String
  performedByName   String?
  fromStatus        String?
  toStatus          String?
  remarks           String?
  createdAt         DateTime @default(now())

  request           StudentServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([performedByUserId])
}

model Certificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique // CERT-2026-000001
  requestId         String?
  studentId         String
  serviceId         String
  certificateType   String    // BONAFIDE | CHARACTER | TRANSFER | MIGRATION | TRANSCRIPT | OTHER
  title             String
  academicYearCode  String    @default("2026-27")
  issueDate         DateTime  @default(now())
  validUntil        DateTime?
  status            String    @default("VALID") // VALID | REVOKED | EXPIRED
  signatoryTitle    String    @default("Registrar / Authorized Signatory")
  verificationHash  String    @unique
  certificateUrl    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service StudentService         @relation(fields: [serviceId], references: [id])
  request StudentServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([certificateNumber])
  @@index([studentId])
  @@index([verificationHash])
  @@index([status])
}

// --- ADMISSION & ENROLLMENT MANAGEMENT ---

model AdmissionCycle {
  id               String   @id @default(uuid())
  code             String   @unique // ADM-2026-REG
  academicYearCode String   @default("2026-27")
  name             String
  admissionType    String   @default("REGULAR") // REGULAR | MERIT | MANAGEMENT | INTERNATIONAL | TRANSFER | LATERAL_ENTRY | OTHER
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  applicationFee   Decimal  @default(500) @db.Decimal(10, 2)
  status           String   @default("ACTIVE") // ACTIVE | CLOSED | UPCOMING
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications     AdmissionApplication[]

  @@index([academicYearCode])
  @@index([status])
}

model AdmissionInquiry {
  id                    String    @id @default(uuid())
  inquiryNo             String    @unique // INQ-2026-000001
  applicantName         String
  mobile                String
  email                 String?
  city                  String?
  state                 String?
  interestedInstituteId String?
  interestedProgramId   String?
  source                String    @default("WEBSITE") // WEBSITE | WALK_IN | SOCIAL_MEDIA | EDUCATION_FAIR | REFERRAL | OTHER
  counsellorUserId      String?
  inquiryDate           DateTime  @default(now())
  nextFollowUpDate      DateTime? @db.Date
  status                String    @default("NEW") // NEW | CONTACTED | COUNSELLING | FOLLOW_UP | CONVERTED | NOT_INTERESTED | CLOSED
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  counsellings          CounsellingRecord[]
  applications          AdmissionApplication[]

  @@index([inquiryNo])
  @@index([status])
  @@index([counsellorUserId])
  @@index([interestedProgramId])
}

model CounsellingRecord {
  id               String   @id @default(uuid())
  inquiryId        String
  counsellorUserId String
  counsellingDate  DateTime @default(now())
  discussionPoints String
  applicantNeed    String?
  nextFollowUpDate DateTime? @db.Date
  remarks          String?
  createdAt        DateTime @default(now())

  inquiry AdmissionInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([counsellorUserId])
}

model AdmissionApplication {
  id               String    @id @default(uuid())
  applicationNo    String    @unique // APP-2026-000001
  inquiryId        String?
  admissionCycleId String
  instituteId      String
  programId        String
  admissionType    String    @default("REGULAR") // REGULAR | MERIT | MANAGEMENT | INTERNATIONAL | TRANSFER | LATERAL_ENTRY
  
  // Applicant Details
  firstName        String
  middleName       String?
  lastName         String
  email            String
  mobile           String
  gender           String?
  dateOfBirth      DateTime? @db.Date
  category         String?   @default("GENERAL") // GENERAL | SC | ST | OBC | EWS
  city             String?
  state            String?
  address          String?
  
  // Academic Qualification
  qualifyingExam   String?   // 12th / Diploma / Bachelor
  qualifyingBoard  String?
  passingYear      Int?
  percentage       Decimal?  @db.Decimal(5, 2)
  
  // Status Tracking
  status           String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_VERIFICATION | DOCUMENT_QUERY | ELIGIBILITY_PENDING | ELIGIBLE | NOT_ELIGIBLE | APPROVAL_PENDING | APPROVED | REJECTED | ADMISSION_CONFIRMED | ENROLLED
  isFeePaid        Boolean   @default(false)
  feeAmountPaid    Decimal   @default(0) @db.Decimal(10, 2)
  feeReceiptNo     String?
  
  submissionDate   DateTime  @default(now())
  verifiedByUserId String?
  verifiedAt       DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  admissionCycle   AdmissionCycle               @relation(fields: [admissionCycleId], references: [id])
  inquiry          AdmissionInquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  documents        AdmissionApplicationDocument[]
  eligibilityResults EligibilityResult[]
  approvals        AdmissionApproval[]
  enrollment       Enrollment?

  @@index([applicationNo])
  @@index([status])
  @@index([programId])
  @@index([instituteId])
  @@index([admissionCycleId])
}

model AdmissionApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  documentType  String   // 10TH_MARKSHEET | 12TH_MARKSHEET | ID_PROOF | TC | MIGRATION | PHOTO | OTHER
  documentUrl   String
  status        String   @default("UPLOADED") // UPLOADED | VERIFIED | REJECTED | QUERY_RAISED
  verifiedBy    String?
  remarks       String?
  uploadedAt    DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model EligibilityRule {
  id               String   @id @default(uuid())
  programId        String
  minQualification String   // 12TH_SCIENCE | 12TH_COMMERCE | 12TH_ANY | DIPLOMA | GRADUATION
  minPercentage    Decimal  @db.Decimal(5, 2)
  requiredSubjects String?  // e.g. "Physics, Mathematics, Chemistry"
  entranceRequired Boolean  @default(false)
  entranceExamName String?  // e.g. "GUJCET, JEE, NEET"
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  @@index([programId])
}

model EligibilityResult {
  id            String   @id @default(uuid())
  applicationId String
  isEligible    Boolean
  calculatedPct Decimal? @db.Decimal(5, 2)
  evaluationLog String?
  evaluatedBy   String   // SYSTEM | USER_ID
  evaluatedAt   DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model AdmissionApproval {
  id             String   @id @default(uuid())
  applicationId  String
  approverRole   String   // ADMISSION_MANAGER | DIRECTOR_ADMISSION | HOI | REGISTRAR
  approverUserId String
  status         String   // APPROVED | REJECTED | RETURNED
  comments       String?
  actedAt        DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Enrollment {
  id               String   @id @default(uuid())
  applicationId    String   @unique
  studentId        String   @unique
  enrollmentNo     String   @unique // 2026SSIUCE0101
  academicYearCode String   @default("2026-27")
  enrolledAt       DateTime @default(now())
  enrolledBy       String   // User ID

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([enrollmentNo])
  @@index([studentId])
}

// --- UNIVERSITY EXAMINATION, EVALUATION & RESULT MANAGEMENT ---

model ExamCentre {
  id            String   @id @default(uuid())
  code          String   @unique // CENTRE-01
  name          String
  instituteId   String?
  building      String
  address       String?
  contactPerson String?
  contactNumber String?
  capacity      Int      @default(500)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms             ExamRoom[]
  centreAllocations ExamCentreAllocation[]
  seatAllocations   ExamSeatAllocation[]
  edpDuties         ExamEdpDuty[]

  @@index([code])
  @@index([status])
}

model ExamRoom {
  id          String   @id @default(uuid())
  centreId    String
  building    String?
  roomNumber  String   // e.g. "ROOM-101"
  roomCode    String?  // e.g. "R101"
  floor       Int      @default(1)
  capacity    Int      @default(40)
  roomType    String   @default("CLASSROOM") // CLASSROOM | LAB | HALL | OTHER
  hasCCTV     Boolean  @default(true)
  status      String   @default("AVAILABLE") // AVAILABLE | UNAVAILABLE | ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  centre          ExamCentre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  invigilations   InvigilatorAssignment[]
  allocations     ExamRoomAllocation[]
  seatAllocations ExamSeatAllocation[]
  edpDuties       ExamEdpDuty[]

  @@unique([centreId, roomNumber])
  @@index([centreId])
  @@index([roomNumber])
  @@index([status])
}

model ExamCentreAllocation {
  id                String   @id @default(uuid())
  examId            String
  centreId          String
  status            String   @default("ACTIVE") // ACTIVE | CANCELLED
  allocatedCapacity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam   Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  centre ExamCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  @@unique([examId, centreId])
  @@index([examId])
  @@index([centreId])
}

model ExamSeatAllocation {
  id             String    @id @default(uuid())
  examId         String
  examScheduleId String?
  centreId       String
  roomId         String
  studentId      String
  hallTicketId   String?
  seatNumber     String    // e.g. "A01", "01"
  row            String?   // e.g. "A"
  column         Int?      // e.g. 1
  status         String    @default("ALLOCATED") // ALLOCATED | CHANGED | CANCELLED
  reason         String?   // Reason for change if applicable
  allocatedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  exam    Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  centre  ExamCentre             @relation(fields: [centreId], references: [id], onDelete: Cascade)
  room    ExamRoom               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history ExamSeatChangeHistory[]

  @@index([examId])
  @@index([centreId])
  @@index([roomId])
  @@index([studentId])
  @@index([seatNumber])
  @@index([status])
}

model ExamSeatChangeHistory {
  id                String   @id @default(uuid())
  seatAllocationId  String
  studentId         String
  examId            String
  fromCentreId      String?
  toCentreId        String?
  fromRoomId        String?
  toRoomId          String?
  fromSeatNumber    String?
  toSeatNumber      String
  reason            String
  changedByUserId   String
  changedAt         DateTime @default(now())

  allocation ExamSeatAllocation @relation(fields: [seatAllocationId], references: [id], onDelete: Cascade)

  @@index([seatAllocationId])
  @@index([studentId])
  @@index([examId])
}

model ExamEdpDuty {
  id              String    @id @default(uuid())
  dutyNo          String    @unique // EXAM-EDP-2026-000001
  examId          String
  dutyDate        DateTime  @db.Date
  shift           String    // MORNING | AFTERNOON | EVENING | "09:30 AM - 12:30 PM"
  centreId        String
  building        String?
  roomId          String?
  dutyType        String    // EDP_OPERATOR | EXAM_SUPPORT | TECHNICAL_SUPPORT | CONTROL_ROOM | OTHER
  staffUserId     String
  status          String    @default("ASSIGNED") // ASSIGNED | CONFIRMED | COMPLETED | CANCELLED | REJECTED
  rejectionReason String?
  remarks         String?
  assignedByUserId String?
  assignedAt      DateTime  @default(now())
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime  @updatedAt

  exam      Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  centre    ExamCentre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  room      ExamRoom?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  staffUser User                 @relation("ExamEdpStaff", fields: [staffUserId], references: [id], onDelete: Cascade)
  history   ExamEdpDutyHistory[]

  @@index([dutyNo])
  @@index([examId])
  @@index([centreId])
  @@index([roomId])
  @@index([staffUserId])
  @@index([dutyDate])
  @@index([status])
}

model ExamEdpDutyHistory {
  id                String   @id @default(uuid())
  dutyId            String
  action            String   // ASSIGNED | CONFIRMED | REJECTED | COMPLETED | CANCELLED | REALLOCATED
  performedByUserId String
  reason            String?
  createdAt         DateTime @default(now())

  duty ExamEdpDuty @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@index([dutyId])
  @@index([performedByUserId])
}

model ExamRoomAllocation {
  id             String    @id @default(uuid())
  examScheduleId String
  roomId         String
  studentId      String
  seatNumber     String?   // e.g. "R101-S01"
  deskNumber     String?
  status         String    @default("ALLOCATED") // ALLOCATED | PRESENT | ABSENT | REALLOCATED
  createdAt      DateTime  @default(now())

  room           ExamRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, studentId])
  @@index([examScheduleId])
  @@index([roomId])
  @@index([studentId])
}

model InvigilatorAssignment {
  id             String   @id @default(uuid())
  examScheduleId String
  roomId         String
  facultyUserId  String
  dutyDate       DateTime @db.Date
  reportingTime  String   // e.g. "09:30 AM"
