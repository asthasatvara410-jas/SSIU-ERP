  category             String   // CERTIFICATE | TRANSCRIPT | DEGREE | DUPLICATE_ID | VERIFICATION | MIGRATION | TRANSFER | MARKSHEET | OTHER
  fee                  Float    @default(0)
  urgentFee            Float    @default(0)
