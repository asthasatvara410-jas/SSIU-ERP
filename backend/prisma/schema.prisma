  fileType          String?
  attachmentType    String   @default("PROBLEM_PHOTO") // PROBLEM_PHOTO | COMPLETION_PHOTO | DOCUMENT
  uploadedByUserId  String
  uploadedByName    String?
  uploadedByRole    String?
  createdAt         DateTime @default(now())

  request           HostelMaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([uploadedByUserId])
