// ──────────────────────────────────────────────────────────────────────────────
// UGC GRIEVANCE, ANTI-RAGGING & ICC CASE MANAGEMENT ENGINE
// ──────────────────────────────────────────────────────────────────────────────

model GrievanceCase {
  id                   String    @id @default(uuid())
  tenantId             String    @default("DEFAULT")
  caseNumber           String    @unique // e.g. "GRV-2026-001234"
  trackingToken        String    // Cryptographically secure tracking token for anonymous status check
  category             String    @default("ACADEMIC") // ACADEMIC, ADMINISTRATIVE, FINANCIAL, HOSTEL, TRANSPORT, FACILITY, DISCIPLINE, HARASSMENT, ANTI_RAGGING, SEXUAL_HARASSMENT, DISCRIMINATION, SAFETY, OTHER
  type                 String    @default("IDENTIFIED") // IDENTIFIED, CONFIDENTIAL, ANONYMOUS
  subject              String
  description          String
  status               String    @default("SUBMITTED") // SUBMITTED, ACKNOWLEDGED, ASSIGNED, UNDER_REVIEW, ACTION_REQUIRED, ESCALATED, RESOLVED, CLOSED, REJECTED, REOPENED
  priority             String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  incidentDate         DateTime?
  incidentLocation     String?
  currentAssigneeId    String?
  currentCommitteeId   String?
  escalationLevel      Int       @default(0)
  escalationDeadline   DateTime?
  resolutionSummary   String?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  complainantIdentity  GrievanceComplainantIdentity?
  evidences            GrievanceEvidence[]
  internalNotes        GrievanceInternalNote[]
  timelineEvents       GrievanceCaseEvent[]

  @@index([caseNumber])
  @@index([category])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([escalationLevel])
  @@index([tenantId])
}

model GrievanceComplainantIdentity {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  caseId             String   @unique
  studentId          String
  identityVisibility String   @default("SYSTEM_ONLY") // SYSTEM_ONLY, AUTHORIZED_OFFICER, DISCLOSED_WITH_PERMISSION
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  case               GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([identityVisibility])
  @@index([tenantId])
}

model GrievanceEvidence {
  id           String   @id @default(uuid())
  tenantId     String   @default("DEFAULT")
  caseId       String
  documentId   String?  // Reference to existing DMS document
  fileUrl      String?
  uploadedBy   String
  description  String?
  fileType     String   @default("PDF")
  createdAt    DateTime @default(now())

  case         GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([documentId])
  @@index([tenantId])
}

model GrievanceInternalNote {
  id         String   @id @default(uuid())
  tenantId   String   @default("DEFAULT")
  caseId     String
  authorId   String
  authorRole String
  note       String
  createdAt  DateTime @default(now())

  case       GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([authorId])
  @@index([tenantId])
}

model GrievanceCaseEvent {
  id        String   @id @default(uuid())
  tenantId  String   @default("DEFAULT")
  caseId    String
  eventType String   // SUBMITTED, ACKNOWLEDGED, ASSIGNED, INFORMATION_REQUESTED, EVIDENCE_ADDED, UNDER_REVIEW, ESCALATED, RESOLVED, CLOSED, REOPENED
  actorId   String?
  title     String
  details   String?
  createdAt DateTime @default(now())

  case      GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([eventType])
  @@index([tenantId])
}

model GrievancePolicy {
  id                    String   @id @default(uuid())
  tenantId              String   @default("DEFAULT")
  category              String   @default("ALL")
  initialAuthority      String   @default("HOD")
  escalationAuthority   String   @default("REGISTRAR")
  deadlineDays          Int      @default(7)
  workingDaysOnly       Boolean  @default(true)
  autoEscalationEnabled Boolean  @default(true)
  version               String   @default("v1.0")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([version])
  @@index([tenantId])
}

