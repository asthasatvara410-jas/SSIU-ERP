  totalMarks       Decimal  @default(0) @db.Decimal(6, 2)
  maxMarks         Decimal  @default(0) @db.Decimal(6, 2)
  percentage       Decimal? @db.Decimal(5, 2)
  sgpa             Decimal? @db.Decimal(4, 2)
  cgpa             Decimal? @db.Decimal(4, 2)
