  priority    String   @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status      String   @default("SUBMITTED") // SUBMITTED | ASSIGNED | IN_PROGRESS | RESOLVED | CLOSED
  assignedTo  String?
  resolution  String?
