  @@index([facultyId])
}

model StartupMilestone {
  id          String    @id @default(uuid())
  startupId   String
  title       String
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING | COMPLETED | DELAYED

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
}

// --- PLACEMENT, TRAINING & ALUMNI ---

model PlacementCompany {
  id            String   @id @default(uuid())
  companyCode   String   @unique
  name          String
  industry      String
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  rating        Int      @default(4)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  drives PlacementDrive[]
}

model PlacementDrive {
  id                 String    @id @default(uuid())
  driveCode          String    @unique // DRV-2026-000001
  companyId          String
  jobRole            String
  packageLpa         Decimal   @db.Decimal(5, 2)
  driveDate          DateTime
  location           String
  jobDescription     String
  applicationDeadline DateTime
  eligibleMinCgpa    Decimal?  @db.Decimal(3, 2)
  status             String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED

  company      PlacementCompany       @relation(fields: [companyId], references: [id])
  applications PlacementApplication[]
  interviews   PlacementInterview[]
  offers       PlacementOffer[]

  @@index([companyId])
  @@index([status])
}

model PlacementApplication {
  id          String   @id @default(uuid())
  driveId     String
  studentId   String
  appliedAt   DateTime @default(now())
  status      String   @default("APPLIED") // APPLIED | SHORTLISTED | INTERVIEWED | SELECTED | REJECTED

  drive   PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id])
  userId  String?
  user    User?          @relation(fields: [userId], references: [id])

  @@unique([driveId, studentId])
  @@index([driveId])
  @@index([studentId])
}

model PlacementInterview {
  id            String   @id @default(uuid())
  driveId       String
  studentId     String
  roundName     String   // TECHNICAL | HR | CODING | GD
