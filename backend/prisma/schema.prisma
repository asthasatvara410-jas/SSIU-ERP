model Payslip {
  id              String   @id @default(uuid())
  payslipNo       String   @unique // PSL-2026-08-000001
  payrollPeriodId String
  employeeId      String
  basic           Decimal  @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  specialAllow    Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  grossAmount     Decimal  @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now())
  pdfUrl          String?
  createdAt       DateTime @default(now())

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([payrollPeriodId])
}

model JobRequisition {
  id               String   @id @default(uuid())
  requisitionNo    String   @unique // REQ-HR-2026-0001
  departmentId     String
  instituteId      String
  positionTitle    String
  employmentType   String   @default("FULL_TIME") // FULL_TIME | ADHOC | VISITING
  vacanciesCount   Int      @default(1)
  minExperience    Int      @default(2) // years
  qualificationReq String
  status           String   @default("OPEN") // OPEN | APPROVED | CLOSED | CANCELLED
  createdAt        DateTime @default(now())

  applications     JobApplication[]

  @@index([departmentId])
  @@index([status])
}

model JobApplication {
  id               String   @id @default(uuid())
  jobRequisitionId String
  candidateName    String
  email            String
  phone            String
  experienceYears  Decimal  @db.Decimal(4, 1)
  highestQual      String
  resumeUrl        String?
  status           String   @default("APPLIED") // APPLIED | SHORTLISTED | INTERVIEW_SCHEDULED | SELECTED | OFFERED | JOINED | REJECTED
  appliedDate      DateTime @default(now())

  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  interviews       Interview[]
