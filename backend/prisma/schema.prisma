// --- UNIVERSITY TRANSPORT & FLEET MANAGEMENT ---

model Vehicle {
  id                         String   @id @default(uuid())
  vehicleNumber              String?  // e.g. "BUS-01" or "VAN-02"
  registrationNumber         String   @unique // GJ-01-AB-1234
  vehicleType                String   @default("BUS") // BUS | MINI_BUS | VAN | AMBULANCE | CAR
  makeModel                  String   // e.g. "Tata Starbus 40 Seater"
  manufacturer               String?  // e.g. "Tata Motors"
  model                      String?  // e.g. "Starbus Ultra"
  year                       Int?     // e.g. 2024
  capacity                   Int      @default(40)
  fuelType                   String   @default("DIESEL") // DIESEL | CNG | ELECTRIC | PETROL
  ownerType                  String   @default("UNIVERSITY") // UNIVERSITY | LEASED | CONTRACT | OTHER
  chassisNumber              String?
  engineNumber               String?
  rcNumber                   String?
  purchaseDate               DateTime?
  insuranceNumber            String?
  insuranceExpiry            DateTime?
  fitnessCertificateNumber   String?
  fitnessExpiry              DateTime?
  permitNumber               String?
  permitExpiry               DateTime?
  pollutionCertificateNumber String?
  pucExpiry                  DateTime?
  status                     String   @default("ACTIVE") // ACTIVE | INACTIVE | UNDER_MAINTENANCE | EXPIRED | RETIRED
  remarks                    String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  allotments                 TransportAllotment[]
  trips                      TransportTrip[]
  maintenances               VehicleMaintenance[]
  documents                  VehicleDocument[]
  incidents                  TransportIncident[]
  complaints                 TransportComplaint[]
  driverMappings             VehicleDriverMapping[]
  routeMappings              VehicleRouteMapping[]

  @@index([status])
  @@index([registrationNumber])
}

model DriverProfile {
  id               String    @id @default(uuid())
  driverId         String?   @unique // DRV-001
  driverName       String
  contactNumber    String
  email            String?
  dateOfBirth      DateTime?
  licenseNumber    String    @unique
  licenseType      String    @default("HEAVY_VEHICLE") // HEAVY_VEHICLE | COMMERCIAL | LIGHT_VEHICLE
  licenseIssueDate DateTime?
  licenseExpiry    DateTime?
  experienceYears  Decimal   @default(5) @db.Decimal(4, 1)
  address          String?
  emergencyContact String?
  driverPhotoUrl   String?
  documentUrl      String?
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | ON_LEAVE | SUSPENDED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents        DriverDocument[]
  trips            TransportTrip[]
  incidents        TransportIncident[]
  vehicleMappings  VehicleDriverMapping[]

  @@index([status])
  @@index([licenseNumber])
}

model DriverDocument {
  id          String    @id @default(uuid())
  driverId    String
  docType     String    // DRIVING_LICENSE | MEDICAL_CERTIFICATE | POLICE_VERIFICATION | TRAINING_CERTIFICATE | OTHER
  docNumber   String
  issueDate   DateTime?
  expiryDate  DateTime?
  docUrl      String?
  uploadedBy  String?
  status      String    @default("VALID") // VALID | EXPIRING_SOON | EXPIRED
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([docType])
  @@index([status])
}

model VehicleDriverMapping {
  id             String    @id @default(uuid())
  vehicleId      String
  driverId       String
  assignedDate   DateTime  @default(now()) @db.Date
  unassignedDate DateTime? @db.Date
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE | REPLACED
  isPrimary      Boolean   @default(true)
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver         DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model TransportRoute {
  id              String   @id @default(uuid())
  routeNumber     String   @unique // R-101
  routeCode       String?  // R-101
  routeName       String   // e.g. "Ahmedabad ISKCON — Gandhinagar Campus"
  startPoint      String
  endPoint        String
  distanceKm      Decimal  @default(25) @db.Decimal(6, 2)
  estDurationMins Int      @default(45)
  monthlyFee      Decimal  @default(2500) @db.Decimal(10, 2)
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops           TransportStop[]
  applications    TransportApplication[]
  allotments      TransportAllotment[]
  trips           TransportTrip[]
  complaints      TransportComplaint[]
  vehicleMappings VehicleRouteMapping[]

  @@index([status])
  @@index([routeNumber])
}

model VehicleRouteMapping {
  id           String    @id @default(uuid())
  vehicleId    String
  routeId      String
  shiftType    String    @default("REGULAR") // REGULAR | MORNING_PICKUP | EVENING_DROP | SPECIAL
  assignedDate DateTime  @default(now()) @db.Date
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
}

model TransportStop {
  id         String   @id @default(uuid())
  routeId    String
  stopName   String
  stopCode   String?
  location   String?
  sequence   Int      @default(1)
  pickupTime String   // e.g. "07:30 AM"
  dropTime   String   // e.g. "05:45 PM"
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  route        TransportRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  applications TransportApplication[]
  allotments   TransportAllotment[]

  @@unique([routeId, sequence])
  @@index([routeId])
}

model TransportApplication {
  id            String   @id @default(uuid())
  applicationNo String   @unique // TRN-APP-2026-000001
  studentId     String
  routeId       String
  stopId        String
  requestType   String   @default("NEW_ALLOCATION") // NEW_ALLOCATION | ROUTE_CHANGE | STOP_CHANGE | TEMPORARY_REQUEST | CANCELLATION
  academicYear  String   @default("2026-27")
  status        String   @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | ALLOCATED | CANCELLED
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop  @relation(fields: [stopId], references: [id])

  @@index([studentId])
  @@index([routeId])
  @@index([status])
}

model TransportAllotment {
  id            String    @id @default(uuid())
  allotmentNo   String    @unique // TRN-ALL-2026-000001
  studentId     String
  vehicleId     String
  routeId       String
  stopId        String
  academicYear  String    @default("2026-27")
  allocatedDate DateTime  @default(now())
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED | TRANSFERRED
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop  @relation(fields: [stopId], references: [id])
  passes        TransportPass[]

  @@index([studentId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
}

model TransportPass {
  id               String   @id @default(uuid())
  passNo           String   @unique // TP-2026-000001
  allotmentId      String
  studentId        String
  validFrom        DateTime @default(now())
  validTo          DateTime
  verificationCode String?
  qrData           String?
  status           String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | SUSPENDED
  issuedAt         DateTime @default(now())

  allotment        TransportAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([allotmentId])
}

model TransportTrip {
  id          String   @id @default(uuid())
  tripNo      String   @unique // TRP-2026-000001
  vehicleId   String
  routeId     String
  driverId    String?
  tripDate    DateTime @db.Date
  shift       String?  // MORNING | EVENING | SPECIAL
  startTime   String   // e.g. "07:00 AM"
  endTime     String?  // e.g. "08:30 AM"
  tripType    String   @default("PICKUP") // PICKUP | DROP | SPECIAL_TRIP | OTHER
  status      String   @default("SCHEDULED") // SCHEDULED | IN_TRANSIT | COMPLETED | DELAYED | CANCELLED
  createdAt   DateTime @default(now())

  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  route       TransportRoute @relation(fields: [routeId], references: [id])
  driver      DriverProfile? @relation(fields: [driverId], references: [id])
  attendances TransportAttendance[]

  @@index([vehicleId])
  @@index([routeId])
  @@index([tripDate])
}

model TransportAttendance {
  id             String   @id @default(uuid())
  tripId         String
  studentId      String
  attendanceDate DateTime @db.Date
  status         String   @default("BOARDED") // BOARDED | NOT_BOARDED
  boardedTime    DateTime @default(now())

  trip           TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tripId, studentId])
  @@index([studentId])
}

model VehicleMaintenance {
  id            String    @id @default(uuid())
  maintenanceNo String    @unique // MNT-VEH-2026-000001
  vehicleId     String
  issue         String
  category      String    @default("ENGINE") // ENGINE | ELECTRICAL | TYRES | BRAKES | BODY_WORK | AC_COOLING | SERVICE_ROUTINE | OTHER
  description   String?
  priority      String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  reportedDate  DateTime  @default(now())
  assignedStaff String?
  estimatedCost Decimal?  @db.Decimal(10, 2)
  actualCost    Decimal?  @db.Decimal(10, 2)
  notesheetId   String?
  status        String    @default("REPORTED") // REPORTED | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
}

model VehicleDocument {
  id         String    @id @default(uuid())
  vehicleId  String
  docType    String    // RC | INSURANCE | FITNESS | PERMIT | POLLUTION | OTHER
  docNumber  String
  issueDate  DateTime?
  expiryDate DateTime?
  docUrl     String?
  uploadedBy String?
  uploadedAt DateTime  @default(now())
  status     String    @default("VALID") // VALID | EXPIRING_SOON | EXPIRED
  remarks    String?

  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([docType])
}

model TransportIncident {
  id          String   @id @default(uuid())
  incidentNo  String   @unique // INC-TRN-2026-000001
  vehicleId   String
  driverId    String?
  date        DateTime @default(now())
  location    String
  description String
  damage      String?
  status      String   @default("REPORTED") // REPORTED | UNDER_INVESTIGATION | RESOLVED | CLOSED
  createdAt   DateTime @default(now())

  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  driver      DriverProfile? @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
}

model TransportComplaint {
  id          String   @id @default(uuid())
  complaintNo String   @unique // CMP-TRN-2026-000001
  studentId   String
  routeId     String?
  vehicleId   String?
  description String
  priority    String   @default("NORMAL")
  status      String   @default("SUBMITTED") // SUBMITTED | IN_PROGRESS | RESOLVED | CLOSED
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route       TransportRoute? @relation(fields: [routeId], references: [id])
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([studentId])
  @@index([status])
}

// --- LIBRARY & LEARNING RESOURCE MANAGEMENT ---

model Library {
  id          String   @id @default(uuid())
  code        String   @unique // LIB-CENTRAL, LIB-ENG
  name        String
  instituteId String?
  location    String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute   Institute?       @relation(fields: [instituteId], references: [id])
  sections    LibrarySection[]
  copies      BookCopy[]

  @@index([instituteId])
  @@index([status])
}

model LibrarySection {
  id          String   @id @default(uuid())
  libraryId   String
  code        String   // SEC-CS, SEC-REF
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  library     Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  shelves     LibraryShelf[]

  @@unique([libraryId, code])
  @@index([libraryId])
}

model LibraryShelf {
  id          String   @id @default(uuid())
  sectionId   String
  shelfNumber String   // RACK-A1, SHELF-04
  floor       String?  @default("Ground")
  capacity    Int      @default(100)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     LibrarySection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  copies      BookCopy[]

  @@index([sectionId])
}

model LibraryCategory {
  id               String   @id @default(uuid())
  code             String   @unique // CS, IT, MECH, BIO, PHARM, LAW, MGMT, GEN
  name             String
  description      String?
  parentCategoryId String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  books            Book[]

  @@index([status])
}

model LibraryAuthor {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  email     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]

  @@index([name])
}

model LibraryPublisher {
  id        String   @id @default(uuid())
  name      String
  address   String?
  contact   String?
  email     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]

  @@index([name])
}

model Book {
  id              String   @id @default(uuid())
  isbn            String   @unique
  title           String
  subtitle        String?
  edition         String?
  publicationYear Int?
  language        String   @default("English")
  categoryId      String?
  subjectId       String?
  authorId        String?
  authorName      String
  publisherId     String?
  publisherName   String?
  description     String?
  keywords        String[]
  coverImage      String?
  resourceType    String   @default("BOOK") // BOOK | JOURNAL | MAGAZINE | THESIS | REFERENCE | E_BOOK | DIGITAL_RESOURCE | OTHER
  totalCopies     Int      @default(0)
  availableCopies Int      @default(0)
  status          String   @default("AVAILABLE") // AVAILABLE | ARCHIVED | OUT_OF_STOCK
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        LibraryCategory?   @relation(fields: [categoryId], references: [id])
  subject         Subject?           @relation(fields: [subjectId], references: [id])
  author          LibraryAuthor?     @relation(fields: [authorId], references: [id])
  publisher       LibraryPublisher?  @relation(fields: [publisherId], references: [id])
  copies          BookCopy[]
  reservations    LibraryReservation[]
  digitalResources DigitalResource[]

  @@index([title])
  @@index([authorName])
  @@index([categoryId])
  @@index([subjectId])
  @@index([resourceType])
  @@index([status])
}

model BookCopy {
  id           String    @id @default(uuid())
  accessionNo  String    @unique // ACC-2026-000001
  barcode      String    @unique // BC-10001
  bookId       String
  libraryId    String?
  shelfId      String?
  rack         String?
  purchaseDate DateTime? @default(now())
  cost         Decimal   @default(0) @db.Decimal(10, 2)
  condition    String    @default("NEW") // NEW | GOOD | FAIR | POOR | DAMAGED
  status       String    @default("AVAILABLE") // AVAILABLE | ISSUED | RESERVED | LOST | DAMAGED | REPAIR | WITHDRAWN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  book         Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library      Library?        @relation(fields: [libraryId], references: [id])
  shelf        LibraryShelf?   @relation(fields: [shelfId], references: [id])
  issues       LibraryIssue[]
  incidents    LibraryIncident[]

  @@index([bookId])
  @@index([libraryId])
  @@index([shelfId])
  @@index([status])
  @@index([barcode])
}

model LibraryMembership {
  id           String    @id @default(uuid())
  membershipNo String    @unique // LIB-MEM-2026-000001
  userId       String
  memberType   String    // STUDENT | FACULTY | EMPLOYEE
  instituteId  String?
  departmentId String?
  issueLimit   Int       @default(3)
  validity     DateTime
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues       LibraryIssue[]
  reservations LibraryReservation[]
  fines        LibraryFine[]
  incidents    LibraryIncident[]

  @@index([userId])
  @@index([memberType])
  @@index([status])
}

model LibraryIssue {
  id             String    @id @default(uuid())
  issueNo        String    @unique // ISS-2026-000001
  memberId       String
  copyId         String
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  returnedDate   DateTime?
  issuedByUserId String?
  renewalCount   Int       @default(0)
  maxRenewals    Int       @default(2)
  fineAmount     Decimal   @default(0) @db.Decimal(10, 2)
  status         String    @default("ISSUED") // ISSUED | RETURNED | OVERDUE | RENEWED | LOST
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member         LibraryMembership @relation(fields: [memberId], references: [id])
  copy           BookCopy          @relation(fields: [copyId], references: [id])
  returnRecord   LibraryReturn?
  fines          LibraryFine[]

  @@index([memberId])
  @@index([copyId])
  @@index([status])
  @@index([dueDate])
}

model LibraryReturn {
  id               String   @id @default(uuid())
  issueId          String   @unique
  returnDate       DateTime @default(now())
  receivedByUserId String?
  condition        String   @default("GOOD") // GOOD | DAMAGED | REPAIR
  fineCharged      Decimal  @default(0) @db.Decimal(10, 2)
  remarks          String?
  createdAt        DateTime @default(now())

  issue            LibraryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model LibraryReservation {
  id            String    @id @default(uuid())
  reservationNo String    @unique // RES-2026-000001
  memberId      String
  bookId        String
  requestDate   DateTime  @default(now())
  expiryDate    DateTime
  status        String    @default("ACTIVE") // ACTIVE | FULFILLED | EXPIRED | CANCELLED
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  member        LibraryMembership @relation(fields: [memberId], references: [id])
  book          Book              @relation(fields: [bookId], references: [id])

  @@index([memberId])
  @@index([bookId])
  @@index([status])
}

model LibraryFine {
  id             String    @id @default(uuid())
  fineNo         String    @unique // FINE-2026-000001
  issueId        String?
  memberId       String
  amount         Decimal   @db.Decimal(10, 2)
  reason         String    // OVERDUE | LOST_BOOK | DAMAGED_BOOK | LATE_FEE
  status         String    @default("UNPAID") // UNPAID | PAID | WAIVED
  transactionRef String?
  paidAt         DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  issue          LibraryIssue?     @relation(fields: [issueId], references: [id])
  member         LibraryMembership @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([issueId])
  @@index([status])
}

model LibraryIncident {
  id                String    @id @default(uuid())
  incidentNo        String    @unique // INC-2026-000001
  memberId          String
  copyId            String
  incidentType      String    // LOST | DAMAGED
  incidentDate      DateTime  @default(now())
  description       String
  evidenceDocId     String?
  replacementCost   Decimal   @default(0) @db.Decimal(10, 2)
  status            String    @default("REPORTED") // REPORTED | VERIFIED | CHARGED | RESOLVED | WRITTEN_OFF
  resolvedAt        DateTime?
  resolutionRemarks String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member            LibraryMembership @relation(fields: [memberId], references: [id])
  copy              BookCopy          @relation(fields: [copyId], references: [id])

  @@index([memberId])
  @@index([copyId])
  @@index([status])
}

model DigitalResource {
  id            String   @id @default(uuid())
  resourceCode  String   @unique // DIG-2026-000001
  title         String
  description   String?
  resourceType  String   // E_BOOK | PDF | JOURNAL | RESEARCH_PAPER | VIDEO | EXTERNAL_RESOURCE
  fileDocId     String?
  accessUrl     String?
  bookId        String?
  instituteId   String?
  departmentId  String?
  programId     String?
  subjectId     String?
  unitNumber    Int?
  facultyId     String?
  isRestricted  Boolean  @default(true)
  allowedRoles  String[] @default(["STUDENT", "FACULTY", "LIBRARY_ADMIN", "SUPER_ADMIN"])
  downloadCount Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book          Book?    @relation(fields: [bookId], references: [id])
  program       Program? @relation(fields: [programId], references: [id])
  subject       Subject? @relation(fields: [subjectId], references: [id])

  @@index([resourceType])
  @@index([programId])
  @@index([subjectId])
  @@index([status])
}

model LibraryNotice {
  id          String   @id @default(uuid())
  noticeNo    String   @unique // NOT-2026-000001
  title       String
  description String
  audience    String   @default("ALL") // ALL | STUDENTS | FACULTY | EMPLOYEES | INSTITUTE | DEPARTMENT | PROGRAM
  targetId    String?
  priority    String   @default("NORMAL") // NORMAL | URGENT | HIGH
  startDate   DateTime @default(now())
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audience])
  @@index([status])
}

model LibraryPolicy {
  id                     String   @id @default(uuid())
  code                   String   @unique // POL-STUDENT-UG, POL-FACULTY
  name                   String
  memberType             String   // STUDENT | FACULTY | EMPLOYEE
  maxBooksIssued         Int      @default(3)
  loanDurationDays       Int      @default(14)
  maxRenewals            Int      @default(2)
  finePerDay             Decimal  @default(5.00) @db.Decimal(8, 2)
  reservationDurationDays Int     @default(3)
  gracePeriodDays        Int      @default(0)
  lostBookMultiplier     Decimal  @default(1.5) @db.Decimal(4, 2)
  damageFinePercentage   Decimal  @default(50.0) @db.Decimal(5, 2)
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([memberType])
  @@index([status])
}

// --- IT HELP DESK & CAMPUS SERVICES ---

model ITTicket {
  id          String    @id @default(uuid())
  ticketNo    String    @unique // IT-2026-000001
  userId      String
  category    String    // PRINTER | INTERNET | WIFI | NETWORK | COMPUTER | SOFTWARE | LOGIN | ERP | OTHER
  priority    String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  title       String
  description String
  assignedTo  String?   // Technician User ID
  status      String    @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | RESOLVED | CLOSED
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
}

model CampusServiceRequest {
  id          String    @id @default(uuid())
  requestNo   String    @unique // CSR-2026-000001
  userId      String
  serviceType String    // ELECTRICAL | PLUMBING | CLEANING | FURNITURE | AC | CLASSROOM | MAINTENANCE | SECURITY | OTHER
  location    String
  description String
  priority    String    @default("NORMAL")
  status      String    @default("PENDING") // PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | REJECTED
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

