  fromStatus        String?
  toStatus          String?
  performedByUserId String
  performedByName   String?
  performedByRole   String?
  remarks           String?
  timestamp         DateTime @default(now())

  request           HostelMaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([performedByUserId])
  @@index([timestamp])
}

model HostelMaintenanceAttachment {
