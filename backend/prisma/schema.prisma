model Investigation {
  id             String    @id @default(uuid())
  tenantId       String    @default("DEFAULT")
  caseId         String
  investigatorId String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  findings       String?
  recommendation String?
  status         String    @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, REVIEW_REQUIRED

  @@index([caseId])
  @@index([investigatorId])
  @@index([status])
  @@index([tenantId])
}

model CaseEvidence {
  id                 String   @id @default(uuid())
  tenantId           String   @default("DEFAULT")
  caseId             String
  documentId         String?  // DMS document reference
  evidenceType       String   @default("DOCUMENT") // DOCUMENT, IMAGE, VIDEO, AUDIO, OTHER
  description        String?
  uploadedBy         String
  uploadedAt         DateTime @default(now())
  verificationStatus String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED

  @@index([caseId])
  @@index([documentId])
  @@index([verificationStatus])
  @@index([tenantId])
}

model CaseAction {
  id          String    @id @default(uuid())
  tenantId    String    @default("DEFAULT")
  caseId      String
  actionType  String    // CORRECTIVE, DISCIPLINARY, MEDIATION, COUNSELING, POLICY_UPDATE, OTHER
  description String
  assignedTo  String?
  dueAt       DateTime?
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime  @default(now())

  @@index([caseId])
  @@index([status])
  @@index([tenantId])
}

model CaseResolution {
  id                    String    @id @default(uuid())
  tenantId              String    @default("DEFAULT")
  caseId                String    @unique
  resolutionType        String    // REDRESSED, UNFOUNDED, WITHDRAWN, CONCILIATED, ESCALATED_LEGAL
  summary               String
  resolvedBy            String
  resolvedAt            DateTime  @default(now())
  studentVisibleSummary String
  status                String    @default("RESOLVED")

  @@index([caseId])
  @@index([status])
  @@index([tenantId])
}

model GrievanceRetentionPolicy {
  id              String   @id @default(uuid())
  tenantId        String   @default("DEFAULT")
  caseType        String   @unique
  retentionPeriod Int      @default(1825) // Days (5 years default)
  legalHold       Boolean  @default(false)
  archiveAfter    Int      @default(365) // Days
  deleteAfter     Int      @default(2555) // Days (7 years)
  createdAt       DateTime @default(now())

  @@index([caseType])
  @@index([legalHold])
  @@index([tenantId])
}

// ============================================================
// SMART EXAMINATION & QUESTION BANK ENGINE MODELS
// ============================================================

model QuestionBank {
  id              String   @id @default(uuid())
  tenantId        String   @default("DEFAULT")
  questionCode    String   @unique
  questionText    String   @db.Text
  questionType    String   @default("MCQ") // MCQ, MULTIPLE_SELECT, TRUE_FALSE, SHORT_ANSWER, LONG_ANSWER, DESCRIPTIVE, NUMERICAL
  options         String?  @db.Text        // JSON string array of options for MCQ/MULTIPLE_SELECT
  correctAnswer   String?  @db.Text        // Correct answer(s) or rubric
  explanation     String?  @db.Text
  marks           Float    @default(1.0)
  difficultyLevel String   @default("MEDIUM") // EASY, MEDIUM, HARD
  bloomLevel      String   @default("UNDERSTAND") // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE
  subjectId       String
  departmentId    String
  programId       String?
  academicYearId  String?
  semester        Int      @default(1)
  topic           String?
  unit            String?
  attachmentUrl   String?
  createdBy       String   // Faculty userId
  status          String   @default("DRAFT") // DRAFT, SUBMITTED_FOR_REVIEW, HOD_APPROVED, REJECTED, AVAILABLE_FOR_PAPER
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         QuestionReview[]
  paperQuestions  ExamPaperQuestion[]

  @@index([tenantId])
  @@index([subjectId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([status])
  @@index([difficultyLevel])
  @@index([questionType])
}

model QuestionReview {
  id           String   @id @default(uuid())
  tenantId     String   @default("DEFAULT")
  questionId   String
  reviewerId   String
  reviewerRole String   // FACULTY, HOD, HOI, SUPER_ADMIN
  action       String   // SUBMITTED, APPROVED, REJECTED, REVISED
  remarks      String?  @db.Text
  createdAt    DateTime @default(now())

  question     QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([questionId])
  @@index([reviewerId])
  @@index([action])
}

model ExamPaper {
  id              String    @id @default(uuid())
  tenantId        String    @default("DEFAULT")
  paperCode       String    @unique
  title           String
  subjectId       String
  departmentId    String
  programId       String?
  academicYearId  String?
  semester        Int       @default(1)
  examType        String    @default("MIDTERM") // MIDTERM, ENDTERM, INTERNAL, PRACTICAL, REMEDIAL, CLASS_TEST
  totalMarks      Float     @default(100.0)
  durationMinutes Int       @default(180)
  instructions    String?   @db.Text
  status          String    @default("DRAFT") // DRAFT, SUBMITTED_FOR_HOD, HOD_APPROVED, HOD_REJECTED, SUBMITTED_FOR_HOI, HOI_LOCKED, HOI_REJECTED, PUBLISHED, ARCHIVED
  createdBy       String    // Faculty userId
  publishedAt     DateTime?
  lockedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions       ExamPaperQuestion[]
  reviews         ExamPaperReview[]

  @@index([tenantId])
  @@index([subjectId])
  @@index([departmentId])
  @@index([createdBy])
  @@index([status])
  @@index([examType])
}

model ExamPaperQuestion {
  id            String   @id @default(uuid())
  tenantId      String   @default("DEFAULT")
  examPaperId   String
  questionId    String
  section       String   @default("SECTION_A") // SECTION_A, SECTION_B, SECTION_C, etc.
  questionOrder Int      @default(1)
  marks         Float    @default(1.0)
  createdAt     DateTime @default(now())

  examPaper     ExamPaper    @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  question      QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examPaperId])
  @@index([questionId])
}

model ExamPaperReview {
  id           String   @id @default(uuid())
  tenantId     String   @default("DEFAULT")
  examPaperId  String
  reviewerId   String
  reviewerRole String   // FACULTY, HOD, HOI, SUPER_ADMIN
  action       String   // SUBMITTED_FOR_HOD, HOD_APPROVED, HOD_REJECTED, SUBMITTED_FOR_HOI, HOI_LOCKED, HOI_REJECTED, PUBLISHED
  remarks      String?  @db.Text
  createdAt    DateTime @default(now())

  examPaper    ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examPaperId])
  @@index([reviewerId])
  @@index([action])
}

model ExamAuditLog {
  id             String   @id @default(uuid())
  tenantId       String   @default("DEFAULT")
  actorId        String
  actorRole      String
  action         String   // CREATE, UPDATE, DELETE, SUBMIT, APPROVE, REJECT, LOCK, PUBLISH, UNPUBLISH, BULK_IMPORT
  entityType     String   // QUESTION, EXAM_PAPER, BULK_UPLOAD
  entityId       String
  previousStatus String?
  newStatus      String?
  metadata       String?  @db.Text // JSON metadata
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
}










