  status        String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hostel        Hostel   @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@index([status])
}

model HostelMaintenanceRequest {
  id                     String    @id @default(uuid())
  requestNo              String    @unique // HOST-MNT-2026-000001
  studentId              String
  hostelId               String
  roomId                 String?
  category               String    // ELECTRICAL | PLUMBING | FURNITURE | AC_FAN | WATER | CLEANING | INTERNET | ROOM | WASHROOM | COMMON_AREA | OTHER
  title                  String
  description            String
  priority               String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status                 String    @default("SUBMITTED") // SUBMITTED | ASSIGNED | IN_PROGRESS | ON_HOLD | RESOLVED | CLOSED | REJECTED | REOPENED
  photoUrl               String?
  assignedToStaffId      String?
  assignedToStaffName    String?
  assignedByUserId       String?
  assignedByName         String?
  assignedAt             DateTime?
  expectedCompletionDate DateTime?
  slaHours               Int       @default(48) // 4 for URGENT, 24 for HIGH, 48 for MEDIUM, 72 for LOW
  slaDueDate             DateTime?
  holdReason             String?
  resolutionDetails      String?
  resolvedAt             DateTime?
  resolvedPhotoUrl       String?
  studentConfirmedAt     DateTime?
  studentRating          Int?
  studentFeedback        String?
  reopenedReason         String?
  reopenedAt             DateTime?
  closedAt               DateTime?
  closedByUserId         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  student     Student                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel      Hostel                         @relation(fields: [hostelId], references: [id])
  room        HostelRoom?                    @relation(fields: [roomId], references: [id])
  history     HostelMaintenanceHistory[]
  attachments HostelMaintenanceAttachment[]

  @@index([requestNo])
  @@index([studentId])
  @@index([hostelId])
  @@index([roomId])
  @@index([category])
  @@index([priority])
  @@index([status])
  @@index([assignedToStaffId])
  @@index([createdAt])
}

model HostelMaintenanceHistory {
