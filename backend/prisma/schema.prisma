// ──────────────────────────────────────────────────────────────────────────────
// PHASE 1A: AI & SMART ACADEMIC ANALYTICS — EARLY ACADEMIC RISK PREDICTION
// ──────────────────────────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AcademicRisk {
  id                String    @id @default(uuid())
  studentId         String
  academicYearId    String
  semesterId        String
  attendanceScore   Float     @default(0)   // 0-100 normalized component score
  assignmentScore   Float     @default(0)   // 0-100 normalized component score
  examinationScore  Float     @default(0)   // 0-100 normalized component score
  engagementScore   Float     @default(0)   // 0-100 normalized component score
  riskScore         Float     @default(0)   // 0-100 weighted composite
  riskLevel         RiskLevel @default(LOW)
  predictionReason  String?
  recommendedAction String?
  lastCalculatedAt  DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])

  @@unique([studentId, academicYearId, semesterId])
  @@index([riskLevel])
  @@index([riskScore])
  @@index([studentId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 38. EDP DUTY & ACADEMIC SURVEILLANCE INSPECTION MANAGEMENT
// ──────────────────────────────────────────────────────────────────────────────

model EdpDuty {
  id                           String    @id @default(uuid())
  dutyNo                       String    @unique // EDP-2026-000001
  departmentId                 String
  subjectId                    String?
  subjectName                  String?
  classRoom                    String    // e.g. "Room 302, Lab 4, Block B"
  batchOrDivision              String?   // e.g. "B.Tech CSE - 4th Sem (Div A)"
  teachingFacultyId            String?   // Faculty taking lecture
  teachingFacultyName          String?
  assignedOfficerId            String    // User performing the EDP inspection
  dutyDate                     DateTime  @db.Date
  startTime                    String    // e.g. "10:30 AM"
  endTime                      String    // e.g. "11:30 AM"
  totalRegisteredStudents      Int       @default(0)
  presentStudentCount          Int       @default(0)
  absentStudentCount           Int       @default(0)
  studentAttendancePercentage  Decimal?  @db.Decimal(5, 2)
  lectureTopic                 String?
  teachingMethodology          String?   // BLACKBOARD | PROJECTOR | PPT | LAB_HANDS_ON | HYBRID
  classroomEnvironment         String?   // DISCIPLINED | NOISY | CLEAN | PROJECTOR_ISSUE
  status                       String    @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | VERIFIED | COMPLETED | CANCELLED
  observations                 String?
  remarks                      String?
  verifiedByUserId             String?
  verifiedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  department                   Department                     @relation(fields: [departmentId], references: [id])
  assignedOfficer              User                           @relation("EdpDutyOfficer", fields: [assignedOfficerId], references: [id])
  teachingFaculty              Faculty?                       @relation("EdpDutyTeachingFaculty", fields: [teachingFacultyId], references: [id])

  photos                       EdpDutyPhoto[]
  studentObservations          EdpDutyStudentObservation[]
  history                      EdpDutyHistory[]

  @@index([dutyNo])
  @@index([departmentId])
  @@index([assignedOfficerId])
  @@index([teachingFacultyId])
  @@index([dutyDate])
  @@index([status])
}

model EdpDutyPhoto {
  id                 String   @id @default(uuid())
  dutyId             String
  photoUrl           String
  caption            String?
  capturedAt         DateTime @default(now())
  uploadedByUserId   String
  fileSize           Int?
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  createdAt          DateTime @default(now())

  duty               EdpDuty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@index([dutyId])
  @@index([uploadedByUserId])
}

model EdpDutyStudentObservation {
  id                 String   @id @default(uuid())
  dutyId             String
  studentId          String?
  enrollmentNo       String
  studentName        String
  attendanceStatus   String   @default("PRESENT") // PRESENT | ABSENT | LATE | LEFT_EARLY
  observationRemarks String?
  createdAt          DateTime @default(now())

  duty               EdpDuty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@index([dutyId])
  @@index([enrollmentNo])
}

model EdpDutyHistory {
  id                String   @id @default(uuid())
  dutyId            String
  action            String   // CREATED | ASSIGNED | STARTED | INSPECTION_SUBMITTED | VERIFIED | UPDATED | CANCELLED
  performedByUserId String
  performedByName   String?
  fromStatus        String?
  toStatus          String?
  remarks           String?
  createdAt         DateTime @default(now())

  duty              EdpDuty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@index([dutyId])
  @@index([performedByUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 39. CENTRALIZED REPORTING & EXPORT AUDIT LOGS
// ──────────────────────────────────────────────────────────────────────────────

model CentralReportAuditLog {
  id                String   @id @default(uuid())
  module            String   // WORK_DIARY | EXAMINATION | RESULTS | ADMISSION | INWARD | OUTWARD | HOSTEL_VISITOR | TRANSPORT | CAMPUS_SERVICES | EDP_DUTY | STUDENTS | FACULTY | FEES
  reportType        String   // SINGLE_RECORD | DATE_WISE | DEPARTMENT_WISE | INSTITUTE_WISE | USER_WISE | STATUS_WISE | FILTER_WISE | DASHBOARD_SUMMARY
  format            String   // JSON | CSV | EXCEL | PDF | HTML_PRINT
  generatedByUserId String
  filterParams      String?  // JSON stringified filters
  rowCount          Int      @default(0)
  generatedAt       DateTime @default(now())

  @@index([module])
  @@index([generatedByUserId])
  @@index([generatedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// 40. CENTRALIZED BULK EXCEL IMPORT SYSTEM
// ──────────────────────────────────────────────────────────────────────────────

model BulkImport {
  id                String          @id @default(uuid())
  importNo          String          @unique // IMP-2026-000001
  importType        String          // STUDENT | FACULTY | SUBJECT | EXAM_FORM | MARKS | HOSTEL_STUDENT | HOSTEL_ROOM | FEE_ASSIGNMENT | TRANSPORT_VEHICLE | TRANSPORT_DRIVER | TRANSPORT_ROUTE
  fileName          String
  fileSize          Int?
  uploadedByUserId  String
  uploadedByName    String?
  uploadedByRole    String?
  instituteId       String?
  departmentId      String?
  status            String          @default("UPLOADED") // UPLOADED | VALIDATING | READY | IMPORTED | PARTIALLY_IMPORTED | FAILED | CANCELLED
  importMode        String          @default("INSERT_ONLY") // INSERT_ONLY | UPSERT
  totalRows         Int             @default(0)
  validRows         Int             @default(0)
  invalidRows       Int             @default(0)
  duplicateRows     Int             @default(0)
  importedRows      Int             @default(0)
  failedRows        Int             @default(0)
  skippedRows       Int             @default(0)
  validationSummary String?         // JSON string summary of errors/warnings
  metadata          String?         // JSON extra info (e.g. examId, academicYear, etc.)
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  uploadedByUser    User            @relation("BulkImportUploader", fields: [uploadedByUserId], references: [id])
  rows              BulkImportRow[]
  history           BulkImportHistory[]

  @@index([importNo])
  @@index([importType])
  @@index([uploadedByUserId])
  @@index([status])
  @@index([createdAt])
}

model BulkImportRow {
  id             String      @id @default(uuid())
  importId       String
  rowNumber      Int
  rawData        String      // JSON string of row key-values
  parsedData     String?     // JSON string of sanitized & normalized data
  status         String      @default("PENDING") // PENDING | VALID | INVALID | DUPLICATE | WARNING | IMPORTED | FAILED | SKIPPED
  targetId       String?     // Entity ID if inserted/updated
  errorMessage   String?
  errorField     String?
  warningMessage String?
  createdAt      DateTime    @default(now())

  import         BulkImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId])
  @@index([status])
}

model BulkImportHistory {
  id                String      @id @default(uuid())
  importId          String
  action            String      // UPLOADED | VALIDATED | CONFIRMED | IMPORTED | FAILED | CANCELLED
  performedByUserId String
  performedByName   String?
  details           String?
  timestamp         DateTime    @default(now())

  import            BulkImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([performedByUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
