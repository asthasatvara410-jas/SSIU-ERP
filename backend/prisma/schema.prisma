  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model DutyRequest {
  id             String    @id @default(uuid())
  requestNo      String    @unique // DTY-2026-000001
  employeeId     String
  dutyType       String    // WORK_FROM_HOME | ON_DUTY | CONFERENCE | UNIVERSITY_DUTY | OFFICIAL_VISIT
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
