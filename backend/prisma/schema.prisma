model PayrollPeriod {
  id           String   @id @default(uuid())
  code         String   @unique // PAY-2026-08
  month        Int      // 1-12
  year         Int      // 2026
  status       String   @default("DRAFT") // DRAFT | PROCESSED | APPROVED | DISBURSED
