  interviewType    String   @default("TECHNICAL") // SCREENING | TECHNICAL | HR | DEAN_INTERVIEW
  interviewerUserId String?
  rating           Decimal? @db.Decimal(3, 1) // 1-5
  feedback         String?
  status           String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdAt        DateTime @default(now())

  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
}

model Offer {
  id               String   @id @default(uuid())
  jobApplicationId String   @unique
  offeredPosition  String
  offeredSalary    Decimal  @db.Decimal(12, 2)
  joiningDate      DateTime @db.Date
  offerLetterUrl   String?
  status           String   @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | JOINED
  createdAt        DateTime @default(now())

  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Resignation {
  id               String    @id @default(uuid())
  resignationNo    String    @unique // RES-2026-000001
  employeeId       String
  submissionDate   DateTime  @default(now())
  requestedLWD     DateTime  @db.Date // Last Working Day
  officialLWD      DateTime? @db.Date
  reason           String
  status           String    @default("SUBMITTED") // SUBMITTED | HOD_APPROVED | HR_APPROVED | CLEARANCE_PENDING | COMPLETED | WITHDRAWN
  exitInterview    String?
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clearance        ExitClearance?

