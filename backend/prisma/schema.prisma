  startupCode        String    @unique // STR-2026-000001
  name               String
  description        String?
  category           String
  sector             String?
  industry           String?
  stage              String    @default("IDEATION") // IDEATION | PROTOTYPE | MVP | EARLY_TRACTION | SCALING | GRADUATED
  incubationCenterId String    @default("INC-MAIN")
  workspaceNo        String?
  website            String?
  contactEmail       String?
  contactPhone       String?
  foundedDate        DateTime?
  status             String    @default("ACTIVE") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, ACTIVE, INCUBATED, GRADUATED, CLOSED, REJECTED
  incubationStatus   String    @default("ACTIVE")
  createdBy          String?
  registrationDate   DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt

  incubationCenter   IncubationCenter? @relation(fields: [incubationCenterId], references: [id])
  members            StartupMember[]
