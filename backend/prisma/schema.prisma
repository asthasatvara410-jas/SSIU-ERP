model PayrollRecord {
  id              String   @id @default(uuid())
  payrollPeriodId String
  employeeId      String
  basicPay        Decimal  @db.Decimal(12, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  deductions      Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal  @db.Decimal(12, 2)
  netSalary       Decimal  @db.Decimal(12, 2)
  paymentStatus   String   @default("PENDING") // PENDING | PAID | HOLD
  paymentMode     String   @default("BANK_TRANSFER")
  transactionRef  String?
  paidDate        DateTime?

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([paymentStatus])
