  departmentNoDue  Boolean  @default(false)
  libraryNoDue     Boolean  @default(false)
  financeNoDue     Boolean  @default(false)
  itAssetsReturned Boolean  @default(false)
  hrFinalSettled   Boolean  @default(false)
  remarks          String?
