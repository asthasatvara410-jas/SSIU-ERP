  @@index([year])
  @@index([status])
}

model AppraisalReview {
  id                 String    @id @default(uuid())
  appraisalCycleId   String
  employeeId         String
  reviewerUserId     String?
  selfAssessment     String?
  goalsAchieved      String?
  reviewerComments   String?
  selfRating         Decimal?  @db.Decimal(3, 1) // e.g. 4.5
  finalRating        Decimal?  @db.Decimal(3, 1)
  recommendation     String?   // PROMOTION | INCREMENT | CONFIRMATION | RETAIN
