# Environment Configuration Template
NODE_ENV=development
PORT=5500

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ssiu_erp?schema=public"

# Authentication & JWT Security
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="8h"
REFRESH_TOKEN_SECRET="super-secret-refresh-key"
REFRESH_TOKEN_EXPIRATION="7d"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5500"

# Storage Configuration
STORAGE_TYPE="local" # local | s3
FILE_UPLOAD_DIR="./uploads"

# Logging & Monitoring
LOG_LEVEL="debug" # debug | info | warn | error

# AI Student Helpdesk (Server-Side Only — Never expose to browser)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Academic Bank of Credits (ABC / APAAR)
ABC_ENABLED=false
ABC_API_BASE_URL="https://api.abc.gov.in/v1"
ABC_API_KEY=""
ABC_CLIENT_ID=""
ABC_CLIENT_SECRET=""
ABC_INSTITUTION_ID="IN-GJ-SSIU-001"

# DigiLocker National Depository & Citizen Document Delivery
DIGILOCKER_ENABLED=false
DIGILOCKER_BASE_URL="https://api.digitallocker.gov.in/public/oauth2/1"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI="https://erp.ssiu.ac.in/api/v1/digilocker/callback"
DIGILOCKER_ISSUER_ID="IN-GJ-SSIU-001"
