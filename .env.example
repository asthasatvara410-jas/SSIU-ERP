# =================================================================
# Swarrnim Startup & Innovation University - ERP Configuration
# Production Environment Variables Template (No Secrets Committed)
# =================================================================

# Server & Port
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# University Public URLs
VITE_APP_NAME="Swarrnim University ERP"
VITE_UNIVERSITY_NAME="Swarrnim Startup & Innovation University"
VITE_PORTAL_URL=https://erp.swarrnim.edu.in
VITE_API_URL=https://api.swarrnim.edu.in/api/v1

# Central PostgreSQL Database
DATABASE_URL=postgresql://swarrnim_db_user:YOUR_DB_PASSWORD@database.swarrnim.edu.in:5432/swarrnim_erp?schema=public&sslmode=require

# JWT & Authentication Secrets
JWT_SECRET=YOUR_SECURE_RANDOM_64_CHAR_HEX_SECRET
JWT_EXPIRY=86400
JWT_REFRESH_SECRET=YOUR_SECURE_RANDOM_64_CHAR_REFRESH_SECRET
JWT_REFRESH_EXPIRY=604800

# Push Notifications (Firebase Cloud Messaging & APNs)
FIREBASE_PROJECT_ID=swarrnim-erp-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@swarrnim-erp-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# Storage & Document Uploads (S3 / Cloud Storage)
STORAGE_BUCKET_NAME=swarrnim-erp-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=YOUR_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=YOUR_STORAGE_SECRET_KEY

# Institutional Notification Channels (SMS / WhatsApp Gateway)
WHATSAPP_API_ENDPOINT=https://api.whatsapp-gateway.swarrnim.edu.in/v1/messages
WHATSAPP_API_TOKEN=YOUR_WHATSAPP_API_TOKEN
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@swarrnim.edu.in
SMTP_PASS=YOUR_SMTP_PASSWORD

# =================================================================
# Government of India National Academic Depository & DigiLocker Requester
# Reference: https://partners.apisetu.gov.in / https://digilocker.gov.in
# =================================================================
DIGILOCKER_ENABLED=true
DIGILOCKER_ENVIRONMENT=production
DIGILOCKER_CLIENT_ID=YOUR_OFFICIAL_DIGILOCKER_CLIENT_ID
DIGILOCKER_CLIENT_SECRET=YOUR_OFFICIAL_DIGILOCKER_CLIENT_SECRET
DIGILOCKER_REDIRECT_URI=https://erp.swarrnim.edu.in/api/v1/digilocker/callback
DIGILOCKER_AUTHORIZE_URL=https://digilocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1
DIGILOCKER_ISSUER_ID=IN-GJ-SSIU-001
DIGILOCKER_ENCRYPTION_KEY=YOUR_SECURE_AES_256_GCM_ENCRYPTION_KEY

# Academic Bank of Credits (ABC) / APAAR National Integration
ABC_ENABLED=true
ABC_ENVIRONMENT=production
ABC_API_BASE_URL=https://api.abc.gov.in/v1

