# Server configuration
PORT=5000
NODE_ENV=development

# Cloud SQL / PostgreSQL Connection String
# Example: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://swarrnim_db_user:YOUR_DB_PASSWORD@database.swarrnim.edu.in:5432/swarrnim_erp?sslmode=require

# Firebase Admin SDK Credentials
# Do NOT commit the actual private key or credentials here.
FIREBASE_PROJECT_ID=ssiu-erp
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@ssiu-erp.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
